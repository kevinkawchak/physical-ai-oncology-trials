% Style file - Elegant serif single column
\NeedsTeXFormat{LaTeX2e}
\ProcessOptions\relax

\renewcommand{\rmdefault}{ppl}

\usepackage[verbose=true,letterpaper]{geometry}
\AtBeginDocument{
  \newgeometry{textheight=9.1in,textwidth=6.2in,top=1.05in,headheight=14pt,headsep=20pt,footskip=30pt}
}

\widowpenalty=10000
\clubpenalty=10000
\flushbottom
\sloppy

\newcommand{\headeright}{}
\newcommand{\shorttitle}{\@title}

\usepackage{fancyhdr}
\fancyhf{}
\pagestyle{fancy}
\renewcommand{\headrulewidth}{0pt}
\fancyheadoffset{0pt}
\rhead{\small\itshape \shorttitle}
\lhead{\small \thepage}
\cfoot{}

\def\keywordname{{\bfseries Keywords \textemdash}}%
\def\keywords#1{\par\addvspace\medskipamount{\rightskip=0pt plus1cm
\def\and{\ifhmode\unskip\nobreak\fi\ ,\
}\noindent\keywordname\enspace\ignorespaces#1\par}}

\renewcommand{\normalsize}{\@setfontsize\normalsize\@xipt{14.2}}
\normalsize

\usepackage{titlesec}
\titleformat{\section}{\large\bfseries\itshape}{\thesection.}{0.5em}{}[\vspace{2pt}\hrule height 0.4pt]
\titleformat{\subsection}{\normalsize\bfseries\itshape}{\thesubsection.}{0.5em}{}
\titlespacing*{\section}{0pt}{2.0ex plus 0.4ex minus 0.2ex}{1.0ex plus 0.2ex}
\titlespacing*{\subsection}{0pt}{1.6ex plus 0.4ex minus 0.2ex}{0.6ex plus 0.2ex}

\setlength{\parindent}{1em}
\setlength{\parskip}{3\p@}

\providecommand{\maketitle}{}
\renewcommand{\maketitle}{\par\begingroup
  \thispagestyle{empty}\@maketitle\endgroup
  \let\maketitle\relax}

\providecommand{\@maketitle}{}
\renewcommand{\@maketitle}{\vbox{\hsize\textwidth \linewidth\hsize
  \vskip 0.35in
  \centering
  {\fontsize{22pt}{26pt}\selectfont\itshape\@title\par}\vskip 0.35in
  {\large\@author}\\[0.3em]
  {\small\@date}\\[0.3em]
  \vskip 0.1in \hrule height 0.4pt \vskip 0.15in}}

\renewenvironment{abstract}
  {\par\noindent\centerline{\bfseries Abstract}\vskip 0.3em\begin{quote}\small}
  {\end{quote}\normalsize}

\endinput
