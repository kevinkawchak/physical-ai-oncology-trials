% \vbarcol{x}{height}{fill}{x label}{top label}
\newcommand{\vbarcol}[5]{%
  \fill[#3] (#1-0.26,0) rectangle (#1+0.26,#2);
  \draw[trialchar,line width=0.3pt] (#1-0.26,0) rectangle (#1+0.26,#2);
  \node[font=\tiny\sffamily,anchor=north,text width=16mm,align=center] at (#1,-0.07) {#4};
  \node[font=\tiny\sffamily,anchor=south,inner sep=1.5pt] at (#1,#2) {#5};}
% \vbarpair{x}{h1}{h2}{fill1}{fill2}{x label} - prior beside new
\newcommand{\vbarpair}[6]{%
  \fill[#4] (#1-0.30,0) rectangle (#1-0.02,#2);
  \draw[trialchar,line width=0.3pt] (#1-0.30,0) rectangle (#1-0.02,#2);
  \fill[#5] (#1+0.02,0) rectangle (#1+0.30,#3);
  \draw[trialchar,line width=0.3pt] (#1+0.02,0) rectangle (#1+0.30,#3);
  \node[font=\tiny\sffamily,anchor=north,text width=17mm,align=center] at (#1,-0.07) {#6};}
% \hmcell{x}{y}{tint 0-100}{label} - one heat-map cell on the burgundy ramp.
\newcommand{\hmcell}[4]{%
  \fill[trialburg!#3] (#1,#2) rectangle (#1+1,#2+0.55);
  \draw[trialchar!35,line width=0.2pt] (#1,#2) rectangle (#1+1,#2+0.55);
  \node[font=\tiny\sffamily,text=black] at (#1+0.5,#2+0.275) {#4};}
\newcommand{\hmcellw}[4]{%
  \fill[trialburg!#3] (#1,#2) rectangle (#1+1,#2+0.55);
  \draw[trialchar!35,line width=0.2pt] (#1,#2) rectangle (#1+1,#2+0.55);
  \node[font=\tiny\sffamily,text=white] at (#1+0.5,#2+0.275) {#4};}
% \ciband{y}{lo}{hi}{point}{label} - an exact interval on a rule.
\newcommand{\ciband}[5]{%
  \draw[trialburg,line width=1.1pt] (#2,#1) -- (#3,#1);
  \draw[trialchar,line width=0.5pt] (#2,#1-0.10) -- (#2,#1+0.10);
  \draw[trialchar,line width=0.5pt] (#3,#1-0.10) -- (#3,#1+0.10);
  \fill[trialburg] (#4,#1) circle (0.055);
  \node[anchor=east,font=\tiny\sffamily] at (-0.15,#1) {#5};}
% \axisx{x0}{x1}{y} and \axisy{y0}{y1}{x} - hairline chart rules.
\newcommand{\axisx}[3]{\draw[trialslate,line width=0.4pt] (#1,#3) -- (#2,#3);}
\newcommand{\axisy}[3]{\draw[trialslate,line width=0.4pt] (#3,#1) -- (#3,#2);}
% \legkey{x}{y}{fill}{text} - one legend swatch.
\newcommand{\legkey}[4]{%
  \fill[#3] (#1,#2-0.09) rectangle (#1+0.30,#2+0.09);
  \draw[trialchar,line width=0.3pt] (#1,#2-0.09) rectangle (#1+0.30,#2+0.09);
  \node[anchor=west,font=\tiny\sffamily] at (#1+0.38,#2) {#4};}
% \ptitle{x}{y}{text} - an in-figure panel title.
\newcommand{\ptitle}[3]{\node[font=\scriptsize\sffamily\bfseries,text=trialburg,anchor=west] at (#1,#2) {#3};}
% \pnote{x}{y}{text} - an in-figure footnote line.
\newcommand{\pnote}[3]{\node[font=\tiny\sffamily,text=trialslate,anchor=west,align=left] at (#1,#2) {#3};}
% \pxmark{x}{y} - the struck-through glyph used where an edge is forbidden.
\newcommand{\pxmark}[2]{%
  \draw[trialchar,line width=0.9pt] (#1-0.13,#2-0.13) -- (#1+0.13,#2+0.13);
  \draw[trialchar,line width=0.9pt] (#1-0.13,#2+0.13) -- (#1+0.13,#2-0.13);}

% ============================================================
% PAPER FURNITURE.  The cover is adapted from the paper template at
% new-trial-system/template-new-system: a centered block, not the parent work's
% ruled panel over a three-cell money ledger.  \trialmast sets the rules and the
% title; \trialbadge and \trialbadgel are the inline badges; \apprule is the
% thin accent rule used between cover blocks.
% ============================================================
% \trialmast{title line 1}{title line 2}{draft line} - the centered cover head.
\newcommand{\trialmast}[3]{%
  \par\begin{center}
    {\color{trialburg}\rule{\linewidth}{1.6pt}}\\[0.45em]
    {\fontsize{17}{21}\selectfont\bfseries #1}\\[0.32em]
    {\fontsize{17}{21}\selectfont\bfseries #2}\\[0.62em]
    {\large\bfseries #3}\\[0.30em]
    {\color{trialburg}\rule{\linewidth}{1.6pt}}
  \end{center}}
% \trialbadge{text} / \trialbadgel{text} - inline badges.
\newcommand{\trialbadge}[1]{%
  \tikz[baseline=(bd.base)]{\node[rectangle,rounded corners=2pt,fill=trialburg,
    text=trialwhite,inner xsep=5pt,inner ysep=2pt,font=\scriptsize\bfseries] (bd) {#1};}}
\newcommand{\trialbadgel}[1]{%
  \tikz[baseline=(bd.base)]{\node[rectangle,rounded corners=2pt,fill=trialburgp,
    draw=trialburg,line width=0.5pt,text=trialburg,inner xsep=5pt,inner ysep=2pt,
    font=\scriptsize\bfseries] (bd) {#1};}}
% \apprule{width} - the thin accent rule used between cover blocks.
\newcommand{\apprule}[1]{{\color{trialburg}\rule{\linewidth}{#1}}}
% \draftinstr{...} - a bracketed drafting instruction, draft stage only.  Every
% one names the exact repository file or directory a later stage must process.
% No \draftinstr survives into full-new-trial or final-new-trial.
\newcommand{\draftinstr}[1]{\par\addvspace{3pt}%
  {\setlength{\parindent}{0pt}\small\color{trialslate}%
   \textbf{[DRAFTING INSTRUCTION]}\itshape\ #1\par}%
  \addvspace{3pt}}
% \figslot{tag}{height in cm}{caption} - a sized placeholder carrying its final
% figure number and type tag, so figure numbering never moves after this stage.
\newcommand{\figslot}[3]{%
  \begin{appfloat}[!tb]
  \begin{appfig}[#1]
  \draw[trialmist,line width=0.5pt] (0,0) rectangle (13.6,#2);
  \node[font=\scriptsize\sffamily,text=trialslate] at (6.8,{#2/2})
    {placeholder, drawn in full-new-trial};
  \end{appfig}
  \vspace{-0.6cm}
  \figcaption{#3}
  \end{appfloat}}

% ---------- Stage 7 helpers.  Two rows that repeat often enough to be worth a
% ---------- macro, so the sequence and gantt figures stay readable in source.
% \seqrow{y}{x1}{x2}{style}{label} - one message row of a sequence diagram.
\newcommand{\seqrow}[5]{%
  \draw[#4] (#2,#1) -- (#3,#1) node[midway,above,font=\tiny\sffamily,
    inner sep=1pt,fill=trialwhite] {#5};}
% \ganttrow{y}{x0}{x1}{style}{left label} - one bar of a gantt chart.
\newcommand{\ganttrow}[5]{%
  \node[anchor=east,font=\tiny\sffamily] at (-0.12,#1) {#5};
  \node[#4,anchor=west,minimum width={(#3-#2)*1cm}] at (#2,#1) {};}

% \pfb - a zero-width break opportunity, for use inside \texttt paths and TikZ
% labels, so a long repository path can never overflow the measure.
\newcommand{\pfb}{\discretionary{}{}{}}
% \appfile{path} is defined at the foot of this file, after url and hyperref.

% ---------- PNG-free ORCID iD mark, in the ORCID green. ----------
\newcommand{\orcidicon}[1]{%
  \href{https://orcid.org/#1}{\protect\tikz[baseline=-0.75ex]{%
    \node[circle,fill=orcidgreen,minimum size=9.2pt,inner sep=0pt](orc){};
    \node at (orc){\textcolor{white}{\sffamily\bfseries\fontsize{5.4}{5.4}\selectfont iD}};}}}

% ---------- Table of contents.  article.cls opens every section entry with
% ---------- \addvspace{1.0em}, which over eleven sections spills the contents
% ---------- onto a second page that is then mostly empty.  The lead is reduced
% ---------- to 0.20em, which keeps the sections visually grouped and brings the
% ---------- contents back to a single page.
\makeatletter
\renewcommand*\l@section[2]{%
  \ifnum \c@tocdepth >\z@
    \addpenalty\@secpenalty
    \addvspace{0.20em \@plus\p@}%
    \setlength\@tempdima{1.5em}%
    \begingroup
      \parindent \z@ \rightskip \@pnumwidth
      \parfillskip -\@pnumwidth
      \leavevmode \bfseries
      \advance\leftskip\@tempdima
      \hskip -\leftskip
      #1\nobreak\hfil
      \nobreak\hb@xt@\@pnumwidth{\hss #2\kern-\p@\kern\p@}\par
    \endgroup
  \fi}
\makeatother

\providecommand{\keywordname}{\textbf{Keywords}}
\providecommand{\keywords}[1]{\par\addvspace{\smallskipamount}%
  {\setlength{\parindent}{0pt}\footnotesize\keywordname\enspace #1\par}}
\providecommand{\bmhead}[1]{\par\addvspace{0.45\baselineskip}\needspace{2\baselineskip}%
  \phantomsection\addcontentsline{toc}{section}{#1}%
  {\noindent\large\bfseries\color{accentcol}#1}\par\addvspace{2pt}}
\providecommand{\cboxx}{\raisebox{0.12ex}{\framebox[1.25ex]{\rule{0pt}{0.95ex}}}}

\RequirePackage[hidelinks,pdfusetitle]{hyperref}
\RequirePackage{url}
% The url package resets \UrlBreaks when it loads, so the any-character break
% rule is re-asserted here, after url and hyperref, together with stretchable
% inter-character glue.  Without this a long bibliography URL cannot be broken
% and overflows the measure.
\def\UrlBreaks{\do\/\do-\do.\do=\do_\do?\do\&\do\%\do\#\do\:\do\a\do\b\do\c%
\do\d\do\e\do\f\do\g\do\h\do\i\do\j\do\k\do\l\do\m\do\n\do\o\do\p\do\q\do\r%
\do\s\do\t\do\u\do\v\do\w\do\x\do\y\do\z\do\A\do\B\do\C\do\D\do\E\do\F\do\G%
\do\H\do\I\do\J\do\K\do\L\do\M\do\N\do\O\do\P\do\Q\do\R\do\S\do\T\do\U\do\V%
\do\W\do\X\do\Y\do\Z\do\0\do\1\do\2\do\3\do\4\do\5\do\6\do\7\do\8\do\9}
\Urlmuskip=0mu plus 3mu\relax
% \appfile{path} - a repository path in monospace.  \nolinkurl and \path both
% fail to break these paths inside a \draftinstr argument, so the scanner below
% inserts an explicit break opportunity after every character: a path can then
% wrap anywhere and can never overflow the measure.  \penalty300 keeps TeX
% preferring a real word space when one is available.
\makeatletter
\def\app@fend{\app@fend}
\def\app@fscan#1{%
  \ifx\app@fend#1%
    \let\app@fnext\relax
  \else
    #1\penalty300\relax
    \let\app@fnext\app@fscan
  \fi
  \app@fnext}
\newcommand{\appfile}[1]{{\hyphenchar\font=-1\relax
  \app@fscan#1\app@fend}}
\makeatother
% ============================================================
% CLICKABLE DOIs AND URLs IN THE REFERENCE LIST.
%
% THE DEFECT THIS SOLVES, RECORDED SO IT IS NOT REDISCOVERED.  references.bib
% carries doi and url fields, but unsrt.bst reads neither: BibTeX drops both,
% and no amount of hyperref configuration can hyperlink data that never reached
% the .bbl.  The fix has two parts.  sections/sec-10 asks for unsrturl rather
% than unsrt; unsrturl is the urlbst-generated companion of unsrt shipped with
% TeX Live and with Overleaf, and it prints a DOI when one is present and a URL
% otherwise.  This file supplies the second part: the marking that makes those
% targets look like targets.
%
% urlbst writes its DOI block in one of two forms, and which one a given TeX
% Live or Overleaf image emits is not under this paper's control:
%
%   FORM A   \doi{10.5281/zenodo.21097442}.
%   FORM B   \href{https://doi.org/10.5281/...}{doi:10.5281/...}.
%
% Both are handled, and the closing period is drawn into the link and into the
% color, so every DOI in this paper sets as one unbroken accent clickable
% string.  FORM A is captured by defining \doi in this file, because a preamble
% definition beats the .bbl's \providecommand.  FORM B is captured by
% \applinkhooks, which wraps \href once, at \begin{document}.
%
% PROSE LINKS.  A third flag, app@prosecolor, routes an ordinary author-written
% \href to the same accent renderer the reference list uses, so every link the
% author wrote by hand is marked and only the machinery links, contents entries
% and internal cross-references, stay undecorated.  \ulink names that intent at
% the call site and is unaffected by \applinkproseoff.
%
% ONE CAVEAT.  The \href wrapper reads its target as an ordinary argument, so a
% target containing a raw percent, hash or tilde must be written with \url or
% \nolinkurl instead.  No DOI contains one, and no target in references.bib
% contains one.
% ============================================================
\renewcommand{\UrlFont}{\color{accentcol}}
\providecommand{\urlprefix}{URL: }
\providecommand{\doitext}{doi:}
\providecommand{\doibase}{https://doi.org/}

\makeatletter
% ---------- Break scanner for the DOI string.  A DOI can be long and the
% ---------- reference list is set in two columns at \scriptsize, so an explicit
% ---------- break opportunity is inserted after every character.
\def\app@dend{\app@dend}
\def\app@dscan#1{%
  \ifx\app@dend#1%
    \let\app@dnext\relax
  \else
    #1\penalty300\relax
    \let\app@dnext\app@dscan
  \fi
  \app@dnext}

\newif\ifapp@inhref \app@inhreffalse
\newif\ifapp@inbib  \app@inbibfalse
\newif\ifapp@doiurl \app@doiurlfalse
\newif\ifapp@prosecolor \app@prosecolortrue

\newcommand{\applinkproseon}{\app@prosecolortrue}
\newcommand{\applinkproseoff}{\app@prosecolorfalse}

\def\app@doiprint#1{%
  \begingroup
    \hyphenchar\font=-1\relax
    \ifapp@inhref
      \textcolor{accentcol}{\doitext\penalty300\expandafter\app@dscan\app@doistr\app@dend#1}%
    \else
      \href{\doibase\app@doistr}{\app@inhreftrue
        \textcolor{accentcol}{\doitext\penalty300\expandafter\app@dscan\app@doistr\app@dend#1}}%
    \fi
  \endgroup}

% Lookahead that does not discard a space.  \@ifnextchar would drop the space it
% skips and run two words together, so \futurelet is used instead.
\def\app@doilook{\futurelet\app@doinext\app@doidecide}
\def\app@doidecide{%
  \ifx\app@doinext.%
    \let\app@doistep\app@doidot
  \else
    \let\app@doistep\app@doiplain
  \fi
  \app@doistep}
\def\app@doidot.{\app@doiprint{.}}
\def\app@doiplain{\app@doiprint{}}

% \dlink{10.5281/zenodo.21097442} - a DOI set as "doi:10.5281/zenodo.21097442."
% in accent burgundy, hyperlinked to the resolver, with the closing period
% inside the link and inside the color.  Write \dlink{...}. in the source: do
% not type "doi:" in front of it, the macro supplies its own prefix.
\DeclareRobustCommand{\dlink}[1]{\def\app@doistr{#1}\app@doilook}
\DeclareRobustCommand{\dlinkbare}[1]{\def\app@doistr{#1}%
  \begingroup\hyphenchar\font=-1\relax
    \ifapp@inhref
      \textcolor{accentcol}{\expandafter\app@dscan\app@doistr\app@dend}%
    \else
      \href{\doibase\app@doistr}{\app@inhreftrue
        \textcolor{accentcol}{\expandafter\app@dscan\app@doistr\app@dend}}%
    \fi
  \endgroup}
\let\doi\dlink

% \ulink{target}{text} - a prose link whose display text is a title, a
% repository name or a version rather than the target itself.  Always colored,
% whatever \applinkproseoff says.  Note the brace placement when a size
% declaration is wanted: \small is a switch, not a one-argument command, so
% write {\small\ulink{...}{...}} and not \small{\ulink{...}{...}}.
\DeclareRobustCommand{\ulink}[2]{%
  \begingroup
    \ifapp@inhref
      \textcolor{accentcol}{#2}%
    \else
      \href{#1}{\app@inhreftrue\textcolor{accentcol}{#2}}%
    \fi
  \endgroup}

\def\app@doiprobe#1doi.org/#2\app@probeend{\def\app@probefound{#2}}
\def\app@isdoiurl#1{\def\app@probefound{}\app@doiprobe#1doi.org/\app@probeend
  \ifx\app@probefound\@empty\app@doiurlfalse\else\app@doiurltrue\fi}

\def\app@hrefwrap{\@ifnextchar[{\app@hrefopt}{\app@hrefplain}}
\def\app@hrefopt[#1]#2#3{\def\app@hopt{#1}\def\app@hurl{#2}\def\app@htext{#3}%
  \app@isdoiurl{#2}\app@hrefopttrue@out}
\def\app@hrefopttrue@out{%
  \ifapp@doiurl
    \let\app@hstep\app@hdotlook
  \else
    \ifapp@inbib
      \let\app@hstep\app@hcolor
    \else
      \ifapp@prosecolor\let\app@hstep\app@hcolor\else\let\app@hstep\app@hplain\fi
    \fi
  \fi
  \app@hstep}
\def\app@hrefplain#1#2{\def\app@hopt{}\def\app@hurl{#1}\def\app@htext{#2}%
  \app@isdoiurl{#1}\app@hrefopttrue@out}
\def\app@hdotlook{\futurelet\app@hnext\app@hdotdecide}
\def\app@hdotdecide{%
  \ifx\app@hnext.%
    \let\app@hnextstep\app@hdot
  \else
    \let\app@hnextstep\app@hcolor
  \fi
  \app@hnextstep}
\def\app@hdot.{\app@realhref{\app@hurl}{\app@inhreftrue
  \textcolor{accentcol}{\app@htext.}}}
\def\app@hcolor{\app@realhref{\app@hurl}{\app@inhreftrue
  \textcolor{accentcol}{\app@htext}}}
\def\app@hplain{\app@realhref{\app@hurl}{\app@inhreftrue\app@htext}}

\newcommand{\applinkhooks}{%
  \ifx\href\app@hrefwrap\else\let\app@realhref\href\let\href\app@hrefwrap\fi}
\AtBeginDocument{\applinkhooks}
\newcommand{\applinkrefs}{\applinkhooks\app@inbibtrue}
\makeatother

% Ragged-right bibliography with generous emergency stretch, so no reference
% line runs past the right margin.
\AtBeginDocument{%
  \let\appoldbibliography\thebibliography
  \renewcommand{\thebibliography}[1]{%
    \appoldbibliography{#1}\raggedright\emergencystretch=8em\relax
    \applinkrefs
    \setlength{\itemsep}{0.8pt}\setlength{\parsep}{0pt}\setlength{\topsep}{0pt}}}
% \apprefs{...} - the reference list set in two columns at \scriptsize.  A paper
% of this length cannot afford a single-column list of long protocol titles, and
% two columns halve its height without shrinking the type further.
\newenvironment{apprefs}%
  {\needspace{4\baselineskip}%
   \setlength{\multicolsep}{0pt}\setlength{\columnsep}{13pt}%
   \begin{multicols}{2}\scriptsize\raggedright
   \applinkrefs
   \setlength{\emergencystretch}{10em}%
   \renewcommand{\section}[2]{}}%
  {\end{multicols}}
\captionsetup{font=small,labelfont=bf,justification=raggedright,singlelinecheck=false}

% ============================================================
% DIAGRAM X SHIFT.  A figure whose content is optically heavier on one side
% reads as though it were off the measure even when its frame is centered.  The
% carrier below nudges such a figure by a named length rather than by an ad hoc
% \hspace, so the shift is auditable and identical wherever it is used.  The
% caption spacing is untouched: \figcaption still follows \vspace{-0.6cm} and
% still sits at 7.44pt from the frame rule.
%
%   \begin{appfloat}[!tb]
%   \begin{adjustwidth}{\DiagramXShift}{\dimexpr-\DiagramXShift\relax}
%   \begin{appfig}[type / construct]  ...  \end{appfig}
%   \end{adjustwidth}
%   \vspace{-0.6cm}
%   \figcaption{...}
%   \end{appfloat}
%
% THE LENGTH IS ZERO, AND THE CARRIER STAYS.  The three centering idioms in this
% file each close with \null, so a frame and a caption both measure to the page
% center and no figure needs a nudge.  It is kept, documented and set to zero,
% so a future optical correction has one named length to change and one named
% environment to wrap, and nothing else.  Note that adjustwidth is a list
% environment and brings its own margin handling, which costs a wrapped figure
% about 1.9pt; do not wrap a figure that does not need it.
% ============================================================
\newlength{\DiagramXShift}
\setlength{\DiagramXShift}{0mm}
