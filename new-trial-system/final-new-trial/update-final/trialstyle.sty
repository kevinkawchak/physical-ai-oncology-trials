% ---------------------------------------------------------------------------
% CLASS DIAGRAM VOCABULARY (update stage).  A UML class is a rectangle cut into
% a name compartment and a member compartment.  The two compartments are drawn
% as two abutting nodes rather than as one \nodepart shape, so that the header
% fill, the member text width and the class height are each set exactly and the
% class carries a real anchor on every edge for association routing.
%
% This vocabulary replaces the stick-actor use case drawing that Figure 14 used
% at the final stage.  A use case diagram states who touches what; it cannot
% state what each party owns, and its association lines have to cross a system
% boundary to say anything at all.  A class diagram states ownership directly:
% the duty sits inside the party that owes it, and an association line is then
% only needed where two parties actually interact.
% ---------------------------------------------------------------------------
\tikzset{
  umlclshdr/.style={rectangle,draw=trialburg,line width=0.7pt,fill=trialburg,
    text=trialwhite,anchor=north west,align=center,inner sep=2.6pt,
    font=\scriptsize\sffamily\bfseries},
  umlclshdrg/.style={umlclshdr,draw=trialslate,fill=trialslate},
  umlclshdrk/.style={umlclshdr,draw=trialburgl,fill=trialburgl,line width=1pt},
  umlclsbody/.style={rectangle,draw=trialburg,line width=0.7pt,fill=trialwhite,
    anchor=north west,align=left,inner sep=3.2pt,font=\tiny\sffamily,
    text=trialblack},
  umlclsbodyg/.style={umlclsbody,draw=trialslate,fill=trialmistl},
  umlclsbodyk/.style={umlclsbody,draw=trialburgl,fill=trialburgp,line width=1pt},
  umlstereo/.style={font=\tiny\sffamily\itshape,text=trialslate,inner sep=1pt},
  umlassoclbl/.style={font=\tiny\sffamily,fill=trialwhite,inner sep=1.2pt,
    text=trialchar}
}

% \umlclass{name}{x}{y}{width in cm}{header style}{body style}{title}{members}
% Draws a two-compartment class whose north west corner is at (x,y).  The header
% node is <name>h and the member node is <name>; both carry standard TikZ
% anchors, so an association attaches to .north, .south, .east or .west and
% meets the frame rule rather than floating beside it.
\newcommand{\umlclass}[8]{%
  \node[#5,minimum width=#4cm,text width={#4cm-0.16cm}] (#1h) at (#2,#3) {#7};
  \node[#6,minimum width=#4cm,text width={#4cm-0.16cm},anchor=north west]
    (#1) at ([shift={(0,-0.001)}]#1h.south west) {#8};}

% \umlactor{name}{x}{y}{label} - a UML stick actor with the label beneath.
% Retained for compatibility with earlier stages of this build.  No figure in
% the update stage uses it.
\newcommand{\umlactor}[4]{%
  \begin{scope}[shift={(#2,#3)},draw=trialburg,line width=0.6pt]
    \draw (0,0.30) circle (0.13);
    \draw (0,0.17) -- (0,-0.20);
    \draw (-0.20,0.02) -- (0.20,0.02);
    \draw (0,-0.20) -- (-0.17,-0.48);
    \draw (0,-0.20) -- (0.17,-0.48);
  \end{scope}
  \node[font=\tiny\sffamily,text width=23mm,align=center,anchor=north] (#1) at (#2,{#3-0.56}) {#4};}

% Fault-tree gate glyphs, used by the graphviz-type fault tree.  An AND gate has
% a flat bottom; an OR gate has a curved bottom.  Neither is filled black.
\newcommand{\umlgateand}[2]{%
  \draw[draw=trialchar,line width=0.6pt,fill=trialmist]
    (#1-0.32,#2-0.20) -- (#1-0.32,#2+0.02)
    arc (180:0:0.32 and 0.26) -- (#1+0.32,#2-0.20) -- cycle;
  \node[font=\tiny\sffamily,anchor=north] at (#1,#2-0.22) {AND};}
\newcommand{\umlgateor}[2]{%
  \draw[draw=trialchar,line width=0.6pt,fill=trialburgp]
    (#1-0.32,#2-0.20) .. controls (#1-0.10,#2-0.06) and (#1+0.10,#2-0.06) .. (#1+0.32,#2-0.20)
    -- (#1+0.32,#2+0.02) arc (0:180:0.32 and 0.26) -- cycle;
  \node[font=\tiny\sffamily,anchor=north] at (#1,#2-0.06) {OR};}

