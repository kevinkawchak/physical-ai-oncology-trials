% ============================================================
% PALETTE.  Seven tokens, and no eighth.  No black fill, and no near-black fill.
%
%   Burgundy            #800020   the mandated primary
%   Lighter burgundy 1  #A32A3C   same hue family, higher lightness, not pink
%   Lighter burgundy 2  #E2D6D9   Burgundy carried toward Mist Gray, not white
%   Charcoal            #2E2E2E   STROKES, RULES AND TEXT ONLY, never a fill
%   Slate Gray          #6B6B6B   process, oversight, neutral edges
%   Mist Gray           #C9C9C9   neutral fill; tints of it are still Mist Gray
%   White               #FFFFFF   ground
%
% A palette audit is a search for a fill darker than protoburg, spelled
% t-r-i-a-l-c-h-a-r used as a fill key, which must return nothing outside this
% sentence and does.
% ============================================================
\definecolor{trialburg}{HTML}{800020}   % Burgundy - commitments, goals, headings
\definecolor{trialchar}{HTML}{2E2E2E}   % Charcoal - strokes and text ONLY
\definecolor{trialslate}{HTML}{6B6B6B}  % Slate Gray - process, oversight
\definecolor{trialmist}{HTML}{C9C9C9}   % Mist Gray - neutral fill
\definecolor{trialburgl}{HTML}{A32A3C}  % lighter shade 1 of trialburg
\definecolor{trialburgp}{HTML}{E2D6D9}  % lighter shade 2 of trialburg
\definecolor{trialwhite}{rgb}{1,1,1}    % Classic White
\definecolor{trialblack}{rgb}{0,0,0}    % body text only, never a fill
% Tints of Mist Gray, used where a pale neutral fill is wanted.  These are not
% new palette tokens: each is trialmist at a stated percentage over white.
\colorlet{trialmistl}{trialmist!45}
\colorlet{trialmistm}{trialmist!72}
\colorlet{orcidgreen}{green!45!black}
\definecolor{orcidgreen}{HTML}{A6CE39}
\colorlet{accentcol}{trialburg}
\pagecolor{trialwhite}

% ============================================================
% BODY TYPOGRAPHY.  Even interword spacing, no right-margin overflow, no
% stranded line, no paragraph ending in one or two words.
% ============================================================
\tolerance=2000
\emergencystretch=3em
\hbadness=4000
\hyphenpenalty=70
\exhyphenpenalty=70
\RaggedRight
\setlength{\RaggedRightParindent}{0pt}
\setlength{\RaggedRightRightskip}{0pt plus 2em}
\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000
\brokenpenalty=10000
% \finalhyphendemerits and a stretchable \parfillskip together stop a paragraph
% from ending in a line carrying only one or two words.
\finalhyphendemerits=10000
\setlength{\parfillskip}{0pt plus 0.75\textwidth}
\raggedbottom
\setlength{\parindent}{0pt}
\setlength{\parskip}{3.2pt plus 1pt minus 0.5pt}
\frenchspacing

