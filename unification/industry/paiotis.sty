% paiotis.sty -- Style for Physical AI Oncology Trial Industry Specification
% Adapted from the Thesis Template for Master's Degree in Engineering (UTB)
% by Edwin Puertas, Universidad Tecnologica de Bolivar
% License: CC BY 4.0
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{paiotis}[2026/03/13 PAIOTIS v1.0 Industry Specification Style]

% -- Page geometry (1.0" top/bottom, 0.75" left/right) --
\RequirePackage[
  letterpaper,
  top=1.0in,
  bottom=1.0in,
  left=0.75in,
  right=0.75in,
  headheight=14pt
]{geometry}

% -- Fonts and encoding --
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{mathptmx}          % Times Roman font family
\RequirePackage{microtype}         % Microtypographic enhancements

% -- Color --
\RequirePackage[dvipsnames]{xcolor}
\definecolor{PAIBlue}{RGB}{0,51,102}
\definecolor{PAIDarkBlue}{RGB}{0,30,60}
\definecolor{PAIBlack}{RGB}{0,0,0}
\definecolor{PAIGray}{RGB}{88,88,88}

% -- Tables --
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{multirow}
\RequirePackage{array}
\RequirePackage{longtable}

% -- Lists and formatting --
\RequirePackage{enumitem}
\setlist{nosep, leftmargin=1.5em}
\setlist[enumerate]{label=\arabic*.}
\setlist[itemize]{label=\textbullet}

% -- Spacing --
\RequirePackage{setspace}
\setstretch{1.08}
\RequirePackage{parskip}
\setlength{\parskip}{0.5ex plus 0.2ex minus 0.1ex}
\setlength{\parindent}{0pt}

% -- Hyperlinks --
\RequirePackage[
  colorlinks=true,
  linkcolor=PAIBlue,
  citecolor=PAIBlue,
  urlcolor=PAIBlue,
  bookmarks=true,
  bookmarksnumbered=true
]{hyperref}

% -- Headers and footers --
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\textit{PAIOTIS v1.0}}
\fancyhead[R]{\small\textit{Physical AI Oncology Trial Industry Specification}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

% -- Section formatting --
\RequirePackage{titlesec}
\titleformat{\section}
  {\normalfont\Large\bfseries\color{PAIBlue}}
  {\thesection}{0.6em}{}
\titlespacing*{\section}{0pt}{2.0ex plus 0.5ex minus 0.2ex}{1.0ex}
\titleformat{\subsection}
  {\normalfont\large\bfseries\color{PAIBlue}}
  {\thesubsection}{0.6em}{}
\titlespacing*{\subsection}{0pt}{1.6ex plus 0.4ex minus 0.2ex}{0.8ex}
\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries\color{PAIBlue}}
  {\thesubsubsection}{0.6em}{}
\titlespacing*{\subsubsection}{0pt}{1.4ex plus 0.3ex minus 0.2ex}{0.6ex}
\titleformat{\paragraph}[runin]
  {\normalfont\normalsize\bfseries\color{PAIDarkBlue}}
  {\theparagraph}{0.5em}{}[.]
\titlespacing*{\paragraph}{0pt}{0.8ex plus 0.2ex minus 0.1ex}{0.5em}

% -- Captions --
\RequirePackage[font=small,labelfont=bf]{caption}

% -- Math --
\RequirePackage{amsmath,amssymb}

% -- Misc --
\RequirePackage{float}
\RequirePackage{ragged2e}

% -- Custom commands --
\newcommand{\doi}[1]{\href{https://doi.org/#1}{\texttt{#1}}}
\newcommand{\SHALL}{\textbf{SHALL}}
\newcommand{\SHOULD}{\textbf{SHOULD}}
\newcommand{\MAY}{\textbf{MAY}}
\newcommand{\MUST}{\textbf{MUST}}
\newcommand{\REQUIRED}{\textbf{REQUIRED}}
\newcommand{\RECOMMENDED}{\textbf{RECOMMENDED}}
\newcommand{\OPTIONAL}{\textbf{OPTIONAL}}
\newcommand{\reporef}[1]{\texttt{#1}}

% -- Justify text with hyphenation --
\tolerance=1000
\emergencystretch=1em
\hyphenpenalty=200

\endinput
