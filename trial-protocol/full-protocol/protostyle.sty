% ============================================================
% protostyle.sty
% Style for the Phase 1 Physical AI Pancreatic Whipple + Daraxonrasib
% Clinical Trial Protocol (trial-protocol/draft-protocol), v4.0.0.
%
% WHAT THIS STYLE IS. It adapts the trial-protocol paper template
% (tmpl01style.sty, recolored to Corporate Blue #00417A) and merges the
% auto-bill-02 final-bill primitives: the full-width ragged-right table columns
% (L, Y, R), the centered white-background ASCII figure (asciifig), and the
% Mermaid-as-TikZ figure (mermaidfig with the mm* node styles), here recolored
% to the protocol palette (Corporate Blue #00417A, Professional Gray #6C757D,
% Classic White, and grayscale). New: a PNG-free TikZ ORCID iD mark. The three
% permitted media - tables, ASCII, and Mermaid-as-TikZ - share one white
% background and one black-ruled centered frame. No raster images anywhere.
%
% Senior-author formatting is centralized here: RaggedRight body with even
% interword spacing and no right-margin overflow; maximal widow/orphan/broken
% penalties so no single line is stranded; long URLs break on any character;
% single hyphens only; the section symbol for every codified reference.
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{protostyle}[2026/06/20 v4.0.0 Physical AI oncology trial protocol style]

% - Times-like serif body (mathptmx is universal on Overleaf). -
\RequirePackage{mathptmx}
\RequirePackage[letterpaper,top=1.0in,bottom=1.0in,left=1.1in,right=1.1in,%
  headheight=15pt,headsep=16pt,footskip=24pt]{geometry}

\RequirePackage{xcolor}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{textcomp}
\RequirePackage[protrusion=true,expansion=false]{microtype}
\RequirePackage{array}
\RequirePackage{longtable}
\RequirePackage{tabularx}
\RequirePackage{xltabular}
\RequirePackage{ragged2e}
\RequirePackage{needspace}
\RequirePackage{enumitem}
\RequirePackage{fancyvrb}
\RequirePackage{booktabs}
\RequirePackage{caption}

% - TikZ for the Mermaid-as-TikZ figures and the ORCID mark. -
\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric,arrows.meta,positioning,fit,backgrounds,calc}

% - Protocol palette. -
\definecolor{protoblue}{HTML}{00417A}   % Corporate Blue - goals, system, accent
\definecolor{protogray}{HTML}{6C757D}   % Professional Gray - process, oversight
\definecolor{protowhite}{rgb}{1,1,1}     % Classic White
\definecolor{protoblack}{rgb}{0,0,0}
\definecolor{protol2}{HTML}{E9ECEF}      % very light gray (light fills)
\definecolor{protol3}{HTML}{D9D9D9}      % decision / warning fill
\definecolor{protodark}{HTML}{222222}    % near-black emphasis fill
\definecolor{orcidgreen}{HTML}{A6CE39}
\colorlet{accentcol}{protoblue}
\pagecolor{protowhite}

% - Even spacing, no right-margin overflow, no big interword gaps. -
\tolerance=2000
\emergencystretch=3em
\hbadness=4000
\hyphenpenalty=70
\exhyphenpenalty=70
\RaggedRight
\setlength{\RaggedRightParindent}{0pt}
\setlength{\RaggedRightRightskip}{0pt plus 2em}

% - No stranded lines. -
\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000
\brokenpenalty=10000
\predisplaypenalty=10000
\postdisplaypenalty=10000

% - Break long URLs on any character. -
\def\UrlBreaks{\do\/\do-\do.\do=\do_\do?\do\&\do\%\do\#\do\:\do\a\do\b\do\c%
\do\d\do\e\do\f\do\g\do\h\do\i\do\j\do\k\do\l\do\m\do\n\do\o\do\p\do\q\do\r%
\do\s\do\t\do\u\do\v\do\w\do\x\do\y\do\z\do\A\do\B\do\C\do\D\do\E\do\F\do\G%
\do\H\do\I\do\J\do\K\do\L\do\M\do\N\do\O\do\P\do\Q\do\R\do\S\do\T\do\U\do\V%
\do\W\do\X\do\Y\do\Z\do\0\do\1\do\2\do\3\do\4\do\5\do\6\do\7\do\8\do\9}
\Urlmuskip=0mu plus 3mu\relax

% The ieeetr style lowercases title fields, so a \S in a title is emitted as \s;
% provide \s so the bibliography renders every codified reference correctly.
\providecommand{\s}{\S}

\setlength{\parindent}{0pt}
\setlength{\parskip}{3.4pt plus 1pt minus 0.5pt}

% - Running header: page left, short protocol title center, version right. -
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\footnotesize\thepage}
\fancyhead[C]{\footnotesize\scshape Whipple + Daraxonrasib Phase 1 Protocol}
\fancyhead[R]{\footnotesize v4.0.0}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\footnotesize\thepage}}

% - Section headings: bold serif accent with a thin rule, numbered. -
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries\color{accentcol}}{\thesection}{0.6em}{}[{\color{accentcol}\titlerule[0.6pt]}]
\titleformat{\subsection}{\normalsize\bfseries\color{accentcol}}{\thesubsection}{0.5em}{}
\titleformat{\subsubsection}{\normalsize\bfseries\itshape\color{protoblack}}{\thesubsubsection}{0.5em}{}
\titlespacing*{\section}{0pt}{1.4ex plus 0.4ex}{0.8ex}
\titlespacing*{\subsection}{0pt}{1.0ex plus 0.3ex}{0.5ex}

% - Table columns: left-aligned ragged-right fixed widths (L), flexible Y,
%   right-aligned numeric R, centered C; every cell starts ragged-right so
%   there are no large interword gaps, and tables sit at the body measure. -
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcommand{\ragcol}[1]{>{\raggedright\arraybackslash}p{#1}}
% Table aesthetics tuned for the body measure: readable row height and tight
% inter-column gaps so full-width tables fill \textwidth without large gaps.
\renewcommand{\arraystretch}{1.18}
\setlength{\tabcolsep}{5pt}

% - Mermaid-as-TikZ node styles (protocol palette). Emphasis by fill and stroke
%   weight; white text on dark fills, black text on light fills. -
\tikzset{
  mmevery/.style={>={Stealth[length=2.2mm]},line width=0.6pt,font=\footnotesize,
    every node/.append style={align=center}},
  mmin/.style={rectangle,rounded corners=2pt,draw=protoblue,fill=protowhite,
    minimum height=8mm,inner sep=3pt,text width=30mm,text=protoblack},
  mmstep/.style={rectangle,rounded corners=2pt,draw=protoblack,fill=protogray,
    minimum height=8mm,inner sep=3pt,text width=30mm,text=protowhite},
  mmdec/.style={diamond,aspect=2,draw=protoblack,fill=protol3,inner sep=1pt,
    text width=24mm,text=protoblack},
  mmgoal/.style={rectangle,rounded corners=2pt,draw=protoblack,line width=1pt,
    fill=protoblue,minimum height=8mm,inner sep=3pt,text width=32mm,text=protowhite},
  mmdark/.style={rectangle,rounded corners=2pt,draw=protoblack,line width=1pt,
    fill=protodark,minimum height=8mm,inner sep=3pt,text width=30mm,text=protowhite},
  mmperson/.style={ellipse,draw=protoblack,fill=protowhite,inner sep=2pt,
    text width=26mm,minimum height=9mm,text=protoblack},
  mmlane/.style={rectangle,draw=protoblack,dashed,inner sep=5pt,rounded corners=1pt},
  mmlanetitle/.style={font=\scriptsize\bfseries},
  mmedge/.style={->,draw=protogray,line width=0.7pt},
  mmedged/.style={->,draw=protogray,dashed,line width=0.7pt},
  mmlabel/.style={font=\scriptsize\itshape,fill=protowhite,inner sep=1pt}
}

% mermaidfig: capture a tikzpicture into a content-width box, frame it on white,
% and center it, mirroring asciifig so the two media carry equal visual weight.
\newsavebox{\mmsavebox}
\newenvironment{mermaidfig}{%
  \par\addvspace{0.55\baselineskip}%
  \needspace{8\baselineskip}%
  \begin{lrbox}{\mmsavebox}%
  \begin{tikzpicture}[mmevery]%
}{%
  \end{tikzpicture}%
  \end{lrbox}%
  \begin{center}%
  \setlength{\fboxrule}{0.4pt}\setlength{\fboxsep}{8pt}%
  \fcolorbox{protoblack}{protowhite}{\usebox{\mmsavebox}}%
  \end{center}%
  \par\addvspace{0.15\baselineskip}}

% ASCII figure: centered, white-background, black-ruled, monospace box that
% preserves spacing exactly, as in a fenced Markdown block.
\newsavebox{\asciifigbox}
\newcommand{\asciifigplace}{%
  \begin{center}%
  \setlength{\fboxrule}{0.4pt}\setlength{\fboxsep}{8pt}%
  \fcolorbox{protoblack}{protowhite}{\usebox{\asciifigbox}}%
  \end{center}%
  \par\addvspace{0.15\baselineskip}}
\newenvironment{asciifig}{%
  \VerbatimEnvironment
  \par\addvspace{0.55\baselineskip}%
  \needspace{6\baselineskip}%
  \begin{lrbox}{\asciifigbox}%
  \begin{BVerbatim}[fontsize=\footnotesize,baselinestretch=0.96]%
}{%
  \end{BVerbatim}%
  \end{lrbox}%
  \asciifigplace}
\newenvironment{asciifigsmall}{%
  \VerbatimEnvironment
  \par\addvspace{0.55\baselineskip}%
  \needspace{6\baselineskip}%
  \begin{lrbox}{\asciifigbox}%
  \begin{BVerbatim}[fontsize=\scriptsize,baselinestretch=0.96]%
}{%
  \end{BVerbatim}%
  \end{lrbox}%
  \asciifigplace}

% Figure / table caption: small centered italic line. Single hyphens only.
\newcommand{\figcaption}[1]{%
  \par\nopagebreak
  \begin{center}\begin{minipage}{0.92\linewidth}%
  \centering\footnotesize\itshape #1%
  \end{minipage}\end{center}%
  \addvspace{0.5\baselineskip}}

% Bracketed drafting-instruction marker for the scaffold (draft stage only).
\newcommand{\draftinstr}[1]{\par\addvspace{2pt}%
  {\setlength{\parindent}{0pt}\small\color{protogray}\textbf{[DRAFTING INSTRUCTION]}\itshape\ #1\par}%
  \addvspace{2pt}}

% PNG-free ORCID iD mark: a green disc with a white "iD", hyperlinked. Replaces
% the orcid_icon.png of the paper template (Rule 3: no PNG).
\newcommand{\orcidicon}[1]{%
  \href{https://orcid.org/#1}{\protect\tikz[baseline=-0.55ex]{%
    \node[circle,fill=orcidgreen,minimum size=9.2pt,inner sep=0pt](orc){};
    \node at (orc){\textcolor{white}{\sffamily\bfseries\fontsize{5.4}{5.4}\selectfont iD}};}}}

% Keywords / subject line: bold label then content.
\providecommand{\keywordname}{\textbf{Keywords}}
\providecommand{\keywords}[1]{\par\addvspace{\medskipamount}%
  {\setlength{\parindent}{0pt}\keywordname\enspace #1\par}}

% Back-matter heading bookmarked into the contents.
\providecommand{\bmhead}[1]{\par\addvspace{0.5\baselineskip}\needspace{2\baselineskip}%
  \phantomsection\addcontentsline{toc}{section}{#1}{\noindent\large\bfseries\color{accentcol}#1}\par\addvspace{2pt}}

% Font-independent empty checkbox.
\providecommand{\cboxx}{\raisebox{0.12ex}{\framebox[1.25ex]{\rule{0pt}{0.95ex}}}}

\RequirePackage[hidelinks,pdfusetitle]{hyperref}
\RequirePackage{url}
\captionsetup{font=small,labelfont=bf,justification=raggedright,singlelinecheck=false}
\endinput
