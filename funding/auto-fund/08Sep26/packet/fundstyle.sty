\newcommand{\glyphlock}[2]{\begin{scope}[shift={(#1.center)},draw=#2,line width=0.45pt]
  \draw (-0.16,-0.24) rectangle (0.16,0.04);\draw (-0.09,0.04) arc (180:0:0.09 and 0.14);
