% ============================================================
% TABLE COLUMNS.  Every fixed-width column carries a prepended
% \raggedright\arraybackslash, so no cell shows a large interword gap, and every
% table is set to the exact body measure with \begin{tabularx}{\textwidth}.
% Column widths are cut to the longest real cell in each column, so no row
% carries one deep cell beside four shallow ones.
% ============================================================
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcommand{\ragcol}[1]{>{\raggedright\arraybackslash}p{#1}}
\renewcommand{\arraystretch}{1.16}
\setlength{\tabcolsep}{4.6pt}
% RIGID SPACING, identical to the figure carrier.  apptable closes with the same
% \vskip 24.5pt that appfig closes with, and \tabcap opens with
% \nointerlineskip, so the source order
%     \end{apptable}  \vspace{-0.60cm}  \tabcap{...}
% leaves exactly 7.44pt from the last rule to the first caption line.  The
% closing \unskip removes the interword space that the newline after
% \end{tabularx} would otherwise contribute: without it every table sets one
% space past the right margin and reports as overfull.
\newenvironment{apptable}{\par\addvspace{0.28em}\noindent\ignorespaces}%
  {\unskip\par\nobreak\vskip 24.5pt\relax}
\newcommand{\thead}[1]{\textcolor{fundwhite}{\bfseries #1}}
\newcommand{\headrow}{\rowcolor{fundaccent}}
\RequirePackage{colortbl}
% \tabcap{...} - a table caption on two centered italic lines, opening with its
% own number.
% X CENTRING.  The closing \null is load-bearing and is the reason this macro,
% \figcaption and the appfig frame all carry one.  TeX deletes a glue item that
% ends a paragraph, so the older idiom
%     \noindent\hfil <box> \hfil\par
% loses its second \hfil at \par; the surviving first \hfil then absorbs the
% whole slack and drives the box against the right margin.  \null is an empty
% \hbox: it ends the paragraph with a box rather than with glue, both \hfil
% survive, and the two split the slack evenly.  It has zero width, height and
% depth, so no spacing invariant in this file moves.
\newcommand{\tabcap}[1]{%
  \nointerlineskip\par\nopagebreak
  {\setlength{\parskip}{0pt}\setlength{\parindent}{0pt}%
   \noindent\null\hfil
   \begin{minipage}{0.94\linewidth}\centering\footnotesize\itshape #1\end{minipage}%
   \hfil\null\par}\addvspace{0.30em}}

% ============================================================
% FIGURE FRAME.  One centered, ruled, white-background frame shared by every
% figure, carrying a monospace tag naming the diagram platform and the native
% construct being reproduced.  The frame fits itself to the text measure and to
% the page, so no figure can overflow horizontally or vertically.
% ============================================================
\newsavebox{\appbox}
\newsavebox{\appfitted}
\newsavebox{\apptagbox}
\newlength{\appmaxw}
\newlength{\appmaxh}
\newlength{\appw}
\def\apptagtext{}

\tikzset{
  appevery/.style={>={Stealth[length=2.1mm]},line width=0.6pt,font=\footnotesize,
    every node/.append style={align=center}}
}

% ---------- FLOAT CARRIER.  A figure too tall for the space left on a page
% ---------- would strand that space.  Wrapping the figure and its caption in an
% ---------- appfloat lets running text close the page and sets the figure at
% ---------- the head of the next one.  One float per page top, none at the
% ---------- bottom, because a figure in these packets is tall.
\setcounter{topnumber}{1}
\setcounter{bottomnumber}{0}
\setcounter{totalnumber}{1}
\renewcommand{\topfraction}{0.90}
\renewcommand{\bottomfraction}{0.0}
\renewcommand{\textfraction}{0.08}
\renewcommand{\floatpagefraction}{0.50}
\setlength{\textfloatsep}{17pt plus 2pt minus 4pt}
\setlength{\floatsep}{15pt plus 2pt minus 4pt}
\setlength{\intextsep}{15pt plus 2pt minus 4pt}
\newif\ifappfloating \appfloatingfalse
\newenvironment{appfloat}[1][!tb]{%
  \begin{figure}[#1]\appfloatingtrue\centering}{\end{figure}}

\newenvironment{appfig}[1][]{%
  \def\apptagtext{#1}%
  \ifappfloating\par\nointerlineskip\else\par\penalty-60\vskip 12pt\relax\fi
  \begin{lrbox}{\appbox}%
  \begin{tikzpicture}[appevery]%
}{%
  \end{tikzpicture}%
  \end{lrbox}%
  \setlength{\appmaxw}{\dimexpr\textwidth-26pt\relax}%
  \setlength{\appmaxh}{0.66\textheight}%
  \begin{lrbox}{\appfitted}%
    \adjustbox{max width=\appmaxw,max totalheight=\appmaxh}{\usebox{\appbox}}%
  \end{lrbox}%
  \sbox{\apptagbox}{\scriptsize\ttfamily\color{fundgray}\apptagtext}%
  \setlength{\appw}{\wd\appfitted}%
  \ifdim\wd\apptagbox>\appw\setlength{\appw}{\wd\apptagbox}\fi
  \ifappfloating\else
    \needspace{\dimexpr\ht\appfitted+\dp\appfitted+4\baselineskip\relax}%
  \fi
  {\setlength{\parskip}{0pt}\setlength{\parindent}{0pt}%
   \setlength{\fboxrule}{0.4pt}\setlength{\fboxsep}{7pt}%
   \noindent\null\hfil
   \fcolorbox{fundink}{fundwhite}{%
     \begin{minipage}{\appw}%
       \raggedright\usebox{\apptagbox}\par\vspace{1.4pt}%
       {\color{fundgraym}\hrule height 0.4pt}\vspace{4.5pt}%
       \noindent\usebox{\appfitted}%
     \end{minipage}}%
   \hfil\null\par}%
  \nobreak\vskip 24.5pt\relax}

% ---------- Caption: a small centered italic block on exactly two manually
% ---------- balanced lines, opening with its own number, "Figure N.".
\newcommand{\figcaption}[1]{%
  \nointerlineskip\nopagebreak
  {\setlength{\parskip}{0pt}\setlength{\parindent}{0pt}%
   \noindent\null\hfil
   \begin{minipage}{0.94\linewidth}%
   \centering\footnotesize\itshape #1%
   \end{minipage}%
   \hfil\null\par}%
  \ifappfloating\else\vskip 12pt\relax\fi}


