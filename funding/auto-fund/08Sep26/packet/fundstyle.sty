% ============================================================
% PALETTE.  The only block that differs between the five daily packets.  Nine
% tokens and no tenth.  fundink is a stroke and text color ONLY: a near-black
% fill is forbidden, and a search for "fundink" inside a fill= key must return
% nothing outside this sentence.
% ============================================================
\definecolor{fundaccent}{HTML}{8A4B2A}  % day accent - commitments, goals, headings
\definecolor{fundmid}{HTML}{B57A55}     % lighter shade 1 of the day accent
\definecolor{fundpale}{HTML}{EFE1D8}    % lighter shade 2 of the day accent
\definecolor{fundgray}{HTML}{6C757D}    % Professional Gray - process, oversight
\definecolor{fundgrayl}{HTML}{E9ECEF}   % grayscale, light
\definecolor{fundgraym}{HTML}{CED4DA}   % grayscale, medium
\definecolor{fundgrayd}{HTML}{9AA1A8}   % grayscale, medium-dark
\definecolor{fundwhite}{rgb}{1,1,1}     % Classic White
\definecolor{fundink}{rgb}{0,0,0}       % strokes and text ONLY, never a fill
\definecolor{orcidgreen}{HTML}{A6CE39}
\colorlet{accentcol}{fundaccent}
\pagecolor{fundwhite}

% ---------- Backward-compatible aliases, so a figure written against the parent
% ---------- style's color names compiles here without edit.
