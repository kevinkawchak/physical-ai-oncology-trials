% ============================================================
% SHARED QUANTITATIVE PRIMITIVES.  Small reusable chart parts so a figure that
% carries data reads as a chart rather than a box-and-arrow drawing, while
% staying pure TikZ: no plotting package, no raster output.
% ============================================================
% \hbarrow{y}{x-end}{fill}{left label}{right label}
\newcommand{\hbarrow}[5]{%
  \node[anchor=east,font=\tiny\sffamily] at (-0.12,#1) {#4};
  \fill[#3] (0,#1-0.17) rectangle (#2,#1+0.17);
  \draw[fundink,line width=0.3pt] (0,#1-0.17) rectangle (#2,#1+0.17);
  \node[anchor=west,font=\tiny\sffamily] at (#2+0.10,#1) {#5};}
% \vbarcol{x}{height}{fill}{x label}{top label}
\newcommand{\vbarcol}[5]{%
  \fill[#3] (#1-0.26,0) rectangle (#1+0.26,#2);
  \draw[fundink,line width=0.3pt] (#1-0.26,0) rectangle (#1+0.26,#2);
  \node[font=\tiny\sffamily,anchor=north,text width=16mm,align=center] at (#1,-0.07) {#4};
  \node[font=\tiny\sffamily,anchor=south,inner sep=1.5pt] at (#1,#2) {#5};}
% \vbarpair{x}{h1}{h2}{fill1}{fill2}{x label} - control beside experimental
\newcommand{\vbarpair}[6]{%
  \fill[#4] (#1-0.30,0) rectangle (#1-0.02,#2);
  \draw[fundink,line width=0.3pt] (#1-0.30,0) rectangle (#1-0.02,#2);
  \fill[#5] (#1+0.02,0) rectangle (#1+0.30,#3);
  \draw[fundink,line width=0.3pt] (#1+0.02,0) rectangle (#1+0.30,#3);
  \node[font=\tiny\sffamily,anchor=north,text width=17mm,align=center] at (#1,-0.07) {#6};}
% \hmcell{x}{y}{tint 0-100}{label} - one heat-map cell on the blue ramp.
\newcommand{\hmcell}[4]{%
  \fill[fundaccent!#3] (#1,#2) rectangle (#1+1,#2+0.55);
  \draw[fundink!35,line width=0.2pt] (#1,#2) rectangle (#1+1,#2+0.55);
  \node[font=\tiny\sffamily,text=black] at (#1+0.5,#2+0.275) {#4};}
\newcommand{\hmcellw}[4]{%
  \fill[fundaccent!#3] (#1,#2) rectangle (#1+1,#2+0.55);
  \draw[fundink!35,line width=0.2pt] (#1,#2) rectangle (#1+1,#2+0.55);
  \node[font=\tiny\sffamily,text=white] at (#1+0.5,#2+0.275) {#4};}
% \ciband{y}{lo}{hi}{point}{label} - an exact interval on a rule.
\newcommand{\ciband}[5]{%
  \draw[fundaccent,line width=1.1pt] (#2,#1) -- (#3,#1);
  \draw[fundink,line width=0.5pt] (#2,#1-0.10) -- (#2,#1+0.10);
  \draw[fundink,line width=0.5pt] (#3,#1-0.10) -- (#3,#1+0.10);
  \fill[fundaccent] (#4,#1) circle (0.055);
  \node[anchor=east,font=\tiny\sffamily] at (-0.15,#1) {#5};}
% \axisx{x0}{x1}{y} and \axisy{y0}{y1}{x} - hairline chart rules.
\newcommand{\axisx}[3]{\draw[fundgray,line width=0.4pt] (#1,#3) -- (#2,#3);}
\newcommand{\axisy}[3]{\draw[fundgray,line width=0.4pt] (#3,#1) -- (#3,#2);}
% \legkey{x}{y}{fill}{text} - one legend swatch.
\newcommand{\legkey}[4]{%
  \fill[#3] (#1,#2-0.09) rectangle (#1+0.30,#2+0.09);
  \draw[fundink,line width=0.3pt] (#1,#2-0.09) rectangle (#1+0.30,#2+0.09);
  \node[anchor=west,font=\tiny\sffamily] at (#1+0.38,#2) {#4};}
% \ptitle{x}{y}{text} - an in-figure panel title.
\newcommand{\ptitle}[3]{\node[font=\scriptsize\sffamily\bfseries,text=fundaccent,anchor=west] at (#1,#2) {#3};}
% \pnote{x}{y}{text} - an in-figure footnote line.
\newcommand{\pnote}[3]{\node[font=\tiny\sffamily,text=fundgray,anchor=west,align=left] at (#1,#2) {#3};}
% \pxmark{x}{y} - the struck-through-cable glyph used where an edge is absent.
\newcommand{\pxmark}[2]{%
  \draw[fundink,line width=0.9pt] (#1-0.13,#2-0.13) -- (#1+0.13,#2+0.13);
  \draw[fundink,line width=0.9pt] (#1-0.13,#2+0.13) -- (#1+0.13,#2-0.13);}


% ---------- Two row helpers, so a sequence figure and a gantt figure stay
% ---------- readable in source.  Both are used by more than one packet.
% \seqrow{y}{x1}{x2}{style}{label} - one message row of a sequence diagram.
\newcommand{\seqrow}[5]{%
  \draw[#4] (#2,#1) -- (#3,#1) node[midway,above,font=\tiny\sffamily,
    inner sep=1pt,fill=fundwhite] {#5};}
% \ganttrow{y}{x0}{x1}{style}{left label} - one bar of a gantt chart.
\newcommand{\ganttrow}[5]{%
  \node[anchor=east,font=\tiny\sffamily] at (-0.12,#1) {#5};
  \node[#4,anchor=west,minimum width={(#3-#2)*1cm}] at (#2,#1) {};}

% ============================================================
% PACKET FURNITURE.  The cover of a daily action packet leads with what is being
% decided, so a solid accent header block carries the decision, a white ruled
% panel carries the subtitle, and a three-cell strip carries the ask, the
% instrument and the horizon.  This is neither the RFA-RM-27-001-v2 centered
% form-field theme nor the parent work's ruled panel over a money ledger.
% ============================================================
% \fundmast{eyebrow}{title}{subtitle} - the accent header block over a ruled
% white panel.  The header is filled with the day accent and its type is
% reversed out, so the packet is identifiable across a desk by color alone.
\newcommand{\fundmast}[3]{%
  \par\noindent\begin{tikzpicture}
    \node[rectangle,draw=fundaccent,line width=0.7pt,fill=fundaccent,
          text width=\dimexpr\textwidth-22pt\relax,
          inner xsep=9pt,inner ysep=7pt,align=left,anchor=north west] (mhh) at (0,0)
          {{\footnotesize\sffamily\bfseries\color{fundwhite} #1}\\[0.34em]
           {\LARGE\bfseries\color{fundwhite} #2}};
    \node[rectangle,draw=fundaccent,line width=0.7pt,fill=fundwhite,
          text width=\dimexpr\textwidth-22pt\relax,
          inner xsep=9pt,inner ysep=7pt,align=left,anchor=north west] (mhb)
          at ([yshift=-0.6pt]mhh.south west)
          {{\small\color{fundink} #3}};
  \end{tikzpicture}\par}
% \fundcell{name}{label}{value}{note}{fill}{text color} - one strip cell.
\newcommand{\fundcell}[6]{%
  \node[rectangle,draw=fundaccent,line width=0.6pt,rounded corners=2pt,fill=#5,
        text width=\dimexpr0.28\textwidth-9pt\relax,minimum height=13.5mm,
        inner sep=4pt,align=center,font=\tiny\sffamily,text=#6,anchor=north west]
        (#1) at (0,0)
        {\textbf{#2}\\[0.20em]{\small\bfseries #3}\\[0.16em]#4};}
% \funddeck{...} - the three-cell decision strip.  Cells are placed by an
% explicit xshift chain rather than by a \foreach over a fill list, because
% choosing a fill with \ifnum inside a TikZ key list expands too late.
\newcommand{\funddeck}[9]{%
  \par\addvspace{0.32em}%
  \noindent\begin{tikzpicture}
    \fundcell{fc@a}{#1}{#2}{#3}{fundaccent}{fundwhite}
    \node[rectangle,draw=fundaccent,line width=0.6pt,rounded corners=2pt,fill=fundpale,
          text width=\dimexpr0.28\textwidth-9pt\relax,minimum height=13.5mm,
          inner sep=4pt,align=center,font=\tiny\sffamily,text=fundaccent,
          anchor=north west]
          (fc@b) at ([xshift=0.055\textwidth]fc@a.north east)
          {\textbf{#4}\\[0.20em]{\small\bfseries #5}\\[0.16em]#6};
    \node[rectangle,draw=fundgray,line width=0.6pt,rounded corners=2pt,fill=fundgrayl,
          text width=\dimexpr0.28\textwidth-9pt\relax,minimum height=13.5mm,
          inner sep=4pt,align=center,font=\tiny\sffamily,text=fundink,
          anchor=north west]
          (fc@c) at ([xshift=0.055\textwidth]fc@b.north east)
          {\textbf{#7}\\[0.20em]{\small\bfseries #8}\\[0.16em]#9};
  \end{tikzpicture}\par\addvspace{0.32em}}
% \appbadge{text} / \appbadgel{text} - inline cover badges.
\newcommand{\appbadge}[1]{%
  \tikz[baseline=(bd.base)]{\node[rectangle,rounded corners=2pt,fill=fundaccent,
    text=fundwhite,inner xsep=5pt,inner ysep=2pt,font=\scriptsize\bfseries] (bd) {#1};}}
\newcommand{\appbadgel}[1]{%
  \tikz[baseline=(bd.base)]{\node[rectangle,rounded corners=2pt,fill=fundpale,
    draw=fundaccent,line width=0.5pt,text=fundaccent,inner xsep=5pt,inner ysep=2pt,
    font=\scriptsize\bfseries] (bd) {#1};}}
% \apprule{width} - the thin accent rule used between cover blocks.
\newcommand{\apprule}[1]{{\color{fundaccent}\rule{\linewidth}{#1}}}
% \actionbox{title}{body} - the single approval box each packet closes §2 with.
% It is the one place in a packet where the chief executive is addressed
% directly, and it is drawn rather than set in bold so it cannot be skimmed past.
\newcommand{\actionbox}[2]{%
  \par\addvspace{0.35em}\needspace{3.2\baselineskip}%
  \noindent\begin{tikzpicture}
    \node[rectangle,draw=fundaccent,line width=1pt,fill=fundpale,rounded corners=3pt,
          text width=\dimexpr\textwidth-24pt\relax,inner xsep=10pt,inner ysep=8pt,
          align=left,anchor=north west] at (0,0)
          {{\small\bfseries\color{fundaccent} #1}\\[0.30em]{\small\color{fundink} #2}};
  \end{tikzpicture}\par\addvspace{0.35em}}
% \figslot{tag}{height in cm}{caption} - a sized placeholder carrying its final
% figure number and type tag.  Kept defined so a figure can be reverted to a
% placeholder without a style edit; no packet calls it.
\newcommand{\figslot}[3]{%
  \begin{appfloat}[!tb]
  \begin{appfig}[#1]
  \draw[fundgraym,line width=0.5pt] (0,0) rectangle (13.6,#2);
  \node[font=\scriptsize\sffamily,text=fundgray] at (6.8,{#2/2}) {placeholder};
  \end{appfig}
  \vspace{-0.60cm}
  \figcaption{#3}
  \end{appfloat}}

% \pfb - a zero-width break opportunity, for use inside \texttt paths and TikZ
% labels, so a long repository path can never overflow the measure.
\newcommand{\pfb}{\discretionary{}{}{}}
% \appfile{path} is defined at the foot of this file, after url and hyperref.

% ---------- PNG-free ORCID iD mark. ----------
\newcommand{\orcidicon}[1]{%
  \href{https://orcid.org/#1}{\protect\tikz[baseline=-0.75ex]{%
    \node[circle,fill=orcidgreen,minimum size=9.2pt,inner sep=0pt](orc){};
    \node at (orc){\textcolor{white}{\sffamily\bfseries\fontsize{5.4}{5.4}\selectfont iD}};}}}

% ---------- Table of contents.  article.cls opens every section entry with
% ---------- \addvspace{1.0em}, which over eight entries spills the contents
% ---------- onto a second page that is then mostly empty.  The lead is reduced
% ---------- to 0.20em, which keeps the sections visually grouped and brings the
% ---------- contents back to a single page.
\makeatletter
\renewcommand*\l@section[2]{%
  \ifnum \c@tocdepth >\z@
    \addpenalty\@secpenalty
    \addvspace{0.20em \@plus\p@}%
    \setlength\@tempdima{1.5em}%
    \begingroup
      \parindent \z@ \rightskip \@pnumwidth
      \parfillskip -\@pnumwidth
      \leavevmode \bfseries
      \advance\leftskip\@tempdima
      \hskip -\leftskip
      #1\nobreak\hfil
      \nobreak\hb@xt@\@pnumwidth{\hss #2\kern-\p@\kern\p@}\par
    \endgroup
  \fi}
\makeatother

\providecommand{\keywordname}{\textbf{Keywords}}
\providecommand{\keywords}[1]{\par\addvspace{\smallskipamount}%
  {\setlength{\parindent}{0pt}\footnotesize\keywordname\enspace #1\par}}
\providecommand{\bmhead}[1]{\par\addvspace{0.45\baselineskip}\needspace{2\baselineskip}%
  \phantomsection\addcontentsline{toc}{section}{#1}%
  {\noindent\large\bfseries\color{accentcol}#1}\par\addvspace{2pt}}
\providecommand{\cboxx}{\raisebox{0.12ex}{\framebox[1.25ex]{\rule{0pt}{0.95ex}}}}

\RequirePackage[hidelinks,pdfusetitle]{hyperref}
\RequirePackage{url}
% The url package resets \UrlBreaks when it loads, so the any-character break
% rule is re-asserted here, after url and hyperref, together with stretchable
% inter-character glue.  Without this a long bibliography URL cannot be broken
% and overflows the measure.
\def\UrlBreaks{\do\/\do-\do.\do=\do_\do?\do\&\do\%\do\#\do\:\do\a\do\b\do\c%
\do\d\do\e\do\f\do\g\do\h\do\i\do\j\do\k\do\l\do\m\do\n\do\o\do\p\do\q\do\r%
\do\s\do\t\do\u\do\v\do\w\do\x\do\y\do\z\do\A\do\B\do\C\do\D\do\E\do\F\do\G%
\do\H\do\I\do\J\do\K\do\L\do\M\do\N\do\O\do\P\do\Q\do\R\do\S\do\T\do\U\do\V%
\do\W\do\X\do\Y\do\Z\do\0\do\1\do\2\do\3\do\4\do\5\do\6\do\7\do\8\do\9}
\Urlmuskip=0mu plus 1mu\relax
% \appfile{path} - a repository path in monospace.  \nolinkurl and \path both
% fail to break these paths inside a macro argument, so the scanner below
% inserts an explicit break opportunity after every character: a path can then
% wrap anywhere and can never overflow the measure.  \penalty300 keeps TeX
% preferring a real word space when one is available.
\makeatletter
\def\app@fend{\app@fend}
\def\app@fscan#1{%
  \ifx\app@fend#1%
    \let\app@fnext\relax
  \else
    #1\penalty300\relax
    \let\app@fnext\app@fscan
  \fi
  \app@fnext}
\newcommand{\appfile}[1]{{\ttfamily\hyphenchar\font=-1\relax
  \app@fscan#1\app@fend}}
\makeatother
% ============================================================
% CLICKABLE DOIs AND URLs IN THE REFERENCE LIST.
%
% THE DEFECT THIS SOLVES.  references.bib carries a doi field on many entries
% and a url field on most.  Plain unsrt.bst reads neither: BibTeX drops both,
% and no amount of hyperref configuration can hyperlink data that never reached
% the .bbl.  A reference list built on identifiers would then print none of
% them.
%
% THE FIX, IN TWO PARTS.  sections/sec-06 asks for unsrturl rather than unsrt.
% unsrturl is the urlbst-generated companion of unsrt shipped with TeX Live and
% with Overleaf; it is unsrt entry for entry, plus two closing blocks: an entry
% with a doi prints \href{https://doi.org/D}{doi:D}, and an entry without one
% prints its url through \url.  An entry carrying both, which is this bib file's
% convention where the url is the DOI resolver, prints the DOI only, so no
% reference shows the same target twice.  This file supplies the second part:
% the marking that makes those targets look like targets.
%
% WHY THE COLOR IS SCOPED THE WAY IT IS.  hyperref is loaded with hidelinks, so
% the contents, the internal cross-references and the cover's prose links carry
% no decoration, which is what a printed page wants.  A reference list is the
% one place a reader is expected to click, so a printed DOI or URL, anything set
% through \url, \path or \dlink, is marked in the accent color, and nothing else
% is.  The rule is: a link whose text IS its target is colored; a link hidden
% behind prose is not.
% ============================================================
\renewcommand{\UrlFont}{\ttfamily\color{accentcol}}
% \dlink{10.5281/zenodo.NNNNNNN} - a DOI printed as text and hyperlinked, so
% every reference carries both the DOI string and a clickable target.
\newcommand{\dlink}[1]{\href{https://doi.org/#1}{\textcolor{accentcol}{#1}}}
% urlbst's .bbl declares these with \providecommand, so declaring them here wins
% and keeps the reference list's wording under this file's control.
\providecommand{\urlprefix}{URL: }
\providecommand{\doitext}{doi:}
% Ragged-right bibliography with generous emergency stretch, so no reference
% line runs past the right margin.
\AtBeginDocument{%
  \let\fundoldbibliography\thebibliography
  \renewcommand{\thebibliography}[1]{%
    \fundoldbibliography{#1}\raggedright\emergencystretch=8em\relax
    \setlength{\itemsep}{0.4pt}\setlength{\parsep}{0pt}\setlength{\topsep}{0pt}}}
% \apprefs{...} - the reference list set in two columns at \scriptsize.  A short
% packet cannot afford a single-column list of long protocol titles, and two
% columns halve its height without shrinking the type further.
\newenvironment{apprefs}%
  {\needspace{4\baselineskip}%
   \setlength{\multicolsep}{0pt}\setlength{\columnsep}{13pt}%
   \begin{multicols}{2}\scriptsize\raggedright
   \setlength{\emergencystretch}{10em}%
   \renewcommand{\section}[2]{}}%
  {\end{multicols}}
\captionsetup{font=small,labelfont=bf,justification=raggedright,singlelinecheck=false}

% ============================================================
% DIAGRAM X SHIFT.  A figure whose content is optically heavier on one side
% reads as though it were off the measure even when its frame is centered.  The
% length is named rather than an ad hoc \hspace, so the shift is auditable and
% identical wherever it is used, and it is set to zero because the three
% centring carriers above now close with \null and every frame and caption in
% these packets measures on the page centre.  It is kept and documented so a
% future optical correction has one named length to change.
%
%   \begin{appfloat}[!tb]
%   \begin{adjustwidth}{\DiagramXShift}{\dimexpr-\DiagramXShift\relax}
%   \begin{appfig}[platform / construct]  ...  \end{appfig}
%   \end{adjustwidth}
%   \vspace{-0.60cm}
%   \figcaption{...}
%   \end{appfloat}
% ============================================================
\newlength{\DiagramXShift}
\setlength{\DiagramXShift}{0mm}
\endinput
