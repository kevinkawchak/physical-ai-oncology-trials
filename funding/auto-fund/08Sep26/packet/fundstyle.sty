% ---------- Vector pictograms.  Every tile carries one; none is a raster.
% ---------- Each takes (node name, stroke colour) and draws itself centred on
% ---------- that node, so tiles stay legible at any figure scale.
\newcommand{\glyphserver}[2]{\begin{scope}[shift={(#1.center)},draw=#2,line width=0.45pt]
  \draw (-0.20,0.26) rectangle (0.20,0.10);\draw (-0.20,0.06) rectangle (0.20,-0.10);
  \draw (-0.20,-0.14) rectangle (0.20,-0.30);
  \fill[#2] (-0.15,0.18) circle (0.022);\fill[#2] (-0.15,-0.02) circle (0.022);
  \fill[#2] (-0.15,-0.22) circle (0.022);\end{scope}}
\newcommand{\glyphdb}[2]{\begin{scope}[shift={(#1.center)},draw=#2,line width=0.45pt]
  \draw (-0.19,0.20) arc (180:360:0.19 and 0.075);\draw (-0.19,0.20) arc (180:0:0.19 and 0.075);
  \draw (-0.19,0.20) -- (-0.19,-0.20);\draw (0.19,0.20) -- (0.19,-0.20);
  \draw (-0.19,-0.20) arc (180:360:0.19 and 0.075);
  \draw (-0.19,0.03) arc (180:360:0.19 and 0.075);\end{scope}}
\newcommand{\glyphcpu}[2]{\begin{scope}[shift={(#1.center)},draw=#2,line width=0.45pt]
  \draw (-0.16,-0.16) rectangle (0.16,0.16);\draw (-0.07,-0.07) rectangle (0.07,0.07);
  \foreach \k in {-0.09,0,0.09}{\draw (\k,0.16) -- (\k,0.25);\draw (\k,-0.16) -- (\k,-0.25);
  \draw (0.16,\k) -- (0.25,\k);\draw (-0.16,\k) -- (-0.25,\k);}\end{scope}}
\newcommand{\glyphnet}[2]{\begin{scope}[shift={(#1.center)},draw=#2,line width=0.45pt]
  \draw (-0.24,0.22) rectangle (-0.06,0.06);\draw (0.06,0.22) rectangle (0.24,0.06);
  \draw (-0.09,-0.28) rectangle (0.09,-0.12);
  \draw (-0.15,0.06) -- (-0.15,-0.02) -- (0.15,-0.02) -- (0.15,0.06);
  \draw (0,-0.02) -- (0,-0.12);\end{scope}}
\newcommand{\glyphrobot}[2]{\begin{scope}[shift={(#1.center)},draw=#2,line width=0.5pt]
  \draw (-0.24,-0.26) -- (-0.10,0.02) -- (0.14,0.14);\fill[#2] (-0.24,-0.26) circle (0.04);
  \fill[#2] (-0.10,0.02) circle (0.035);\draw (0.14,0.14) -- (0.24,0.04);
  \draw (0.14,0.14) -- (0.22,0.24);\draw (-0.28,-0.30) rectangle (-0.14,-0.24);\end{scope}}
\newcommand{\glyphshield}[2]{\begin{scope}[shift={(#1.center)},draw=#2,line width=0.45pt]
  \draw (0,0.27) -- (0.20,0.16) -- (0.20,-0.06) -- (0,-0.28) -- (-0.20,-0.06) -- (-0.20,0.16) -- cycle;
  \draw[line width=0.55pt] (-0.09,0.02) -- (-0.02,-0.08) -- (0.11,0.12);\end{scope}}
\newcommand{\glyphdoc}[2]{\begin{scope}[shift={(#1.center)},draw=#2,line width=0.45pt]
  \draw (-0.16,-0.26) -- (-0.16,0.26) -- (0.07,0.26) -- (0.18,0.15) -- (0.18,-0.26) -- cycle;
  \draw (0.07,0.26) -- (0.07,0.15) -- (0.18,0.15);
  \foreach \k in {0.04,-0.04,-0.12}{\draw (-0.10,\k) -- (0.11,\k);}\end{scope}}
\newcommand{\glyphmon}[2]{\begin{scope}[shift={(#1.center)},draw=#2,line width=0.45pt]
  \draw (-0.24,-0.08) rectangle (0.24,0.24);\draw (-0.06,-0.08) -- (-0.06,-0.22);
  \draw (0.06,-0.08) -- (0.06,-0.22);\draw (-0.16,-0.22) -- (0.16,-0.22);
