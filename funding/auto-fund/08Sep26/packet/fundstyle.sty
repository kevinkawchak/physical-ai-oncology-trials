\colorlet{protogray}{fundgray}
\colorlet{protowhite}{fundwhite}
\colorlet{protoblack}{fundink}
\colorlet{pagrayl}{fundgrayl}
\colorlet{pagraym}{fundgraym}
\colorlet{pagrayd}{fundgrayd}
