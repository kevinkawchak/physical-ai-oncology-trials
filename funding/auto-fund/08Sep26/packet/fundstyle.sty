% ============================================================
% BODY TYPOGRAPHY.  Even interword spacing, no right-margin overflow, no
% stranded line, and no paragraph ending in a one-word or two-word line.
% ============================================================
\tolerance=2000
\emergencystretch=3em
\hbadness=4000
\hyphenpenalty=70
\exhyphenpenalty=70
\RaggedRight
\setlength{\RaggedRightParindent}{0pt}
% 2em of stretch, and no more.  A larger right skip lets a ragged-right line end
% far short of the measure and reads as a gap; a smaller one forces interword
% stretch back into the line.  Measured at this body width, 2em is the value at
% which neither defect appears.
\setlength{\RaggedRightRightskip}{0pt plus 2em}
\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000
\brokenpenalty=10000
% \finalhyphendemerits and a stretchable \parfillskip together stop a paragraph
% from ending in a line carrying only one or two words.
\finalhyphendemerits=10000
\setlength{\parfillskip}{0pt plus 0.75\textwidth}
\raggedbottom
\setlength{\parindent}{0pt}
\setlength{\parskip}{3.2pt plus 1pt minus 0.5pt}
\frenchspacing

% ---------- Break long URLs on any character so no link overflows. ----------
\def\UrlBreaks{\do\/\do-\do.\do=\do_\do?\do\&\do\%\do\#\do\:\do\a\do\b\do\c%
\do\d\do\e\do\f\do\g\do\h\do\i\do\j\do\k\do\l\do\m\do\n\do\o\do\p\do\q\do\r%
\do\s\do\t\do\u\do\v\do\w\do\x\do\y\do\z\do\A\do\B\do\C\do\D\do\E\do\F\do\G%
\do\H\do\I\do\J\do\K\do\L\do\M\do\N\do\O\do\P\do\Q\do\R\do\S\do\T\do\U\do\V%
\do\W\do\X\do\Y\do\Z\do\0\do\1\do\2\do\3\do\4\do\5\do\6\do\7\do\8\do\9}
% The unsrt family lowercases title fields, so a \S in a title is emitted as
% \s; provide \s so every codified reference renders the section symbol.
\providecommand{\s}{\S}

