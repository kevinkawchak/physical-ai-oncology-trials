% ============================================================
% PALETTE.  Eight tokens, and no ninth.  No black fill.
% ============================================================
\definecolor{protoblue}{HTML}{00417A}   % Corporate Blue - commitments, goals
\definecolor{protogray}{HTML}{6C757D}   % Professional Gray - process, oversight
\definecolor{protowhite}{rgb}{1,1,1}    % Classic White
\definecolor{protoblack}{rgb}{0,0,0}    % strokes and text ONLY, never a fill
\definecolor{pagrayl}{HTML}{E9ECEF}     % grayscale, light
\definecolor{pagraym}{HTML}{CED4DA}     % grayscale, medium
\definecolor{pagrayd}{HTML}{9AA1A8}     % grayscale, medium-dark
\definecolor{pablue1}{HTML}{3C7DB2}     % lighter shade 1 of protoblue
\definecolor{pablue2}{HTML}{DCE8F1}     % lighter shade 2 of protoblue
\definecolor{orcidgreen}{HTML}{A6CE39}
\colorlet{accentcol}{protoblue}
\pagecolor{protowhite}

% ============================================================
% BODY TYPOGRAPHY.  Even interword spacing, no right-margin overflow, no
% stranded line, no paragraph ending in one or two words.
% ============================================================
\tolerance=2000
\emergencystretch=3em
\hbadness=4000
\hyphenpenalty=70
\exhyphenpenalty=70
\RaggedRight
\setlength{\RaggedRightParindent}{0pt}
\setlength{\RaggedRightRightskip}{0pt plus 2em}
\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000
\brokenpenalty=10000
% \finalhyphendemerits and a stretchable \parfillskip together stop a paragraph
% from ending in a line carrying only one or two words.
\finalhyphendemerits=10000
\setlength{\parfillskip}{0pt plus 0.75\textwidth}
\raggedbottom
\setlength{\parindent}{0pt}
\setlength{\parskip}{3.2pt plus 1pt minus 0.5pt}
\frenchspacing

% ---------- Break long URLs on any character so no link overflows. ----------
\def\UrlBreaks{\do\/\do-\do.\do=\do_\do?\do\&\do\%\do\#\do\:\do\a\do\b\do\c%
\do\d\do\e\do\f\do\g\do\h\do\i\do\j\do\k\do\l\do\m\do\n\do\o\do\p\do\q\do\r%
\do\s\do\t\do\u\do\v\do\w\do\x\do\y\do\z\do\A\do\B\do\C\do\D\do\E\do\F\do\G%
\do\H\do\I\do\J\do\K\do\L\do\M\do\N\do\O\do\P\do\Q\do\R\do\S\do\T\do\U\do\V%
\do\W\do\X\do\Y\do\Z\do\0\do\1\do\2\do\3\do\4\do\5\do\6\do\7\do\8\do\9}
% The unsrt family lowercases title fields, so a \S in a title is emitted as
% \s; provide \s so every codified reference renders the section symbol.
\providecommand{\s}{\S}

% ---------- Running header.  \apphdr is set by each application's main.tex.
\RequirePackage{fancyhdr}
\newcommand{\apphdr}[1]{\fancyhead[C]{\footnotesize\scshape #1}}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\footnotesize\thepage}
\fancyhead[C]{\footnotesize\scshape Independent Scientist to Novel Performer}
\fancyhead[R]{\footnotesize Draft 1.0}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\footnotesize\thepage}}

% ---------- Section headings. ----------
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries\color{accentcol}}{\thesection}{0.55em}{}[{\color{accentcol}\titlerule[0.6pt]}]
\titleformat{\subsection}{\normalsize\bfseries\color{accentcol}}{\thesubsection}{0.45em}{}
\titleformat{\subsubsection}{\normalsize\bfseries\itshape\color{protoblack}}{\thesubsubsection}{0.45em}{}
\titlespacing*{\section}{0pt}{1.25ex plus 0.35ex}{0.7ex}
\titlespacing*{\subsection}{0pt}{0.95ex plus 0.3ex}{0.45ex}
\titlespacing*{\subsubsection}{0pt}{0.85ex plus 0.3ex}{0.35ex}

% ---------- No heading may be the last thing on a page.  Reserving the heading
% ---------- plus three lines of its own text moves the pair together.
\let\app@section\section
\renewcommand{\section}{\needspace{3.4\baselineskip}\app@section}
\let\app@subsection\subsection
\renewcommand{\subsection}{\needspace{3\baselineskip}\app@subsection}
\let\app@subsubsection\subsubsection
\renewcommand{\subsubsection}{\needspace{2.6\baselineskip}\app@subsubsection}

% ============================================================
% TABLE COLUMNS.  Every fixed-width column is ragged-right so no cell shows a
% large interword gap, and every table is set to the exact body measure.
% ============================================================
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcommand{\ragcol}[1]{>{\raggedright\arraybackslash}p{#1}}
\renewcommand{\arraystretch}{1.16}
\setlength{\tabcolsep}{4.6pt}
% \apptable / \endapptable wrap a full-width table with the fixed vertical
% space applied above and below every table in the ten applications.  The
% closing \unskip removes the interword space that the newline after
% \end{tabularx} would otherwise contribute: without it every table sets one
% space (0.25em, 2.74pt) past the right margin and reports as overfull.
% RIGID SPACING, identical to the figure carrier.  apptable closes with the
% same \vskip 24.5pt that appfig closes with and \tabcap opens with
% \nointerlineskip, so the source order
%     \end{apptable}  \vspace{-0.65cm}  \tabcap{...}
% leaves exactly 24.5pt - 0.65cm = 6.06pt from the last rule to the first
% caption line, for every table, exactly as for every figure.
\newenvironment{apptable}{\par\addvspace{0.28em}\noindent\ignorespaces}%
  {\unskip\par\nobreak\vskip 24.5pt\relax}
% \thead{...} - the Corporate Blue header cell used by every table.
\newcommand{\thead}[1]{\textcolor{protowhite}{\bfseries #1}}
\newcommand{\headrow}{\rowcolor{protoblue}}
\RequirePackage{colortbl}
% \tabcap{...} - a table caption, set to the same measure and idiom as
% \figcaption so tables and figures read as one system.  The caption opens with
% its own number, "Table N.", and is broken by hand onto at most three centred
% lines of near-equal width.
% X CENTRING.  The closing \null is load-bearing and is the reason this macro,
% \figcaption and the appfig frame all now carry one.  TeX deletes a glue item
% that ends a paragraph, so the older idiom
%     \noindent\hfil <box> \hfil\par
% lost its second \hfil at \par; the surviving first \hfil then absorbed the
% whole slack and drove the box hard against the right margin, 13.1pt off centre
% at this measure.  \null is an empty \hbox: it ends the paragraph with a box
% rather than with glue, the second \hfil survives, and the two \hfil then split
% the slack evenly.  It has zero width, height and depth, so no spacing
% invariant in this file moves.
\newcommand{\tabcap}[1]{%
  \nointerlineskip\par\nopagebreak
  {\setlength{\parskip}{0pt}\setlength{\parindent}{0pt}%
   \noindent\null\hfil
   \begin{minipage}{0.94\linewidth}\centering\footnotesize\itshape #1\end{minipage}%
   \hfil\null\par}\addvspace{0.30em}}

% ============================================================
% FIGURE FRAME.  One centred, black-ruled, white-background frame shared by
% every figure, carrying a monospace tag naming the diagram type and the native
% construct being reproduced.  The frame fits itself to the text measure and to
% the page, so no figure can overflow horizontally or vertically.
%
% SPACING INVARIANT: source order is always
%   \end{appfig} \vspace{-0.65cm} \figcaption{...}
% ============================================================
\newsavebox{\appbox}
\newsavebox{\appfitted}
\newsavebox{\apptagbox}
\newlength{\appmaxw}
\newlength{\appmaxh}
\newlength{\appw}
\def\apptagtext{}

\tikzset{
  appevery/.style={>={Stealth[length=2.1mm]},line width=0.6pt,font=\footnotesize,
    every node/.append style={align=center}}
}

% ---------- FLOAT CARRIER.  A figure too tall for the space left on a page
% ---------- would otherwise strand that space.  Wrapping the figure and its
% ---------- caption in an appfloat lets running text close the page and sets
% ---------- the figure at the head of the next one.
% FLOAT BUDGET.  A figure in this paper is tall: the median is 8.2cm of canvas
% plus a frame and a three-line caption.  With the parent work's topnumber of 3
% two of them plus a full-width table were placed on one page, which overfilled
% the vertical box by 143pt.  One float per page top, one per bottom, two in
% total, and a float page that accepts a single figure.
\setcounter{topnumber}{1}
\setcounter{bottomnumber}{0}
\setcounter{totalnumber}{1}
\renewcommand{\topfraction}{0.86}
\renewcommand{\bottomfraction}{0.0}
\renewcommand{\textfraction}{0.08}
\renewcommand{\floatpagefraction}{0.45}
\setlength{\textfloatsep}{17pt plus 2pt minus 4pt}
\setlength{\floatsep}{15pt plus 2pt minus 4pt}
\setlength{\intextsep}{15pt plus 2pt minus 4pt}
\newif\ifappfloating \appfloatingfalse
\newenvironment{appfloat}[1][!tb]{%
  \begin{figure}[#1]\appfloatingtrue\centering}{\end{figure}}

% RIGID SPACING.  Every skip below is rigid and \figcaption opens with
% \nointerlineskip, so the distance from the frame rule to the first caption
% line is exactly 24.5pt - 0.65cm = 6.06pt for every figure, floating or inline.
\newenvironment{appfig}[1][]{%
  \def\apptagtext{#1}%
  \ifappfloating\par\nointerlineskip\else\par\penalty-60\vskip 12pt\relax\fi
  \begin{lrbox}{\appbox}%
  \begin{tikzpicture}[appevery]%
}{%
  \end{tikzpicture}%
  \end{lrbox}%
  \setlength{\appmaxw}{\dimexpr\textwidth-26pt\relax}%
  \setlength{\appmaxh}{0.66\textheight}%
  \begin{lrbox}{\appfitted}%
    \adjustbox{max width=\appmaxw,max totalheight=\appmaxh}{\usebox{\appbox}}%
  \end{lrbox}%
  \sbox{\apptagbox}{\scriptsize\ttfamily\color{protogray}\apptagtext}%
  \setlength{\appw}{\wd\appfitted}%
  \ifdim\wd\apptagbox>\appw\setlength{\appw}{\wd\apptagbox}\fi
  \ifappfloating\else
    \needspace{\dimexpr\ht\appfitted+\dp\appfitted+5\baselineskip\relax}%
  \fi
  {\setlength{\parskip}{0pt}\setlength{\parindent}{0pt}%
   \setlength{\fboxrule}{0.4pt}\setlength{\fboxsep}{7pt}%
   \noindent\null\hfil
   \fcolorbox{protoblack}{protowhite}{%
     \begin{minipage}{\appw}%
       \raggedright\usebox{\apptagbox}\par\vspace{1.4pt}%
       {\color{pagraym}\hrule height 0.4pt}\vspace{4.5pt}%
       \noindent\usebox{\appfitted}%
     \end{minipage}}%
   \hfil\null\par}%
  \nobreak\vskip 24.5pt\relax}

% ---------- Caption: small centred italic block on at most three manually
% ---------- balanced lines, opening with its own number, "Figure N.".  Rigid
% ---------- leading and trailing space, so the whole figure-plus-caption
% ---------- whitespace signature is identical everywhere.  The lines of one
% ---------- caption are balanced to the narrowest spread the word boundaries
% ---------- allow; across the paper a caption line runs 59 to 80 characters,
% ---------- because a caption three lines long is as wide as its own text.
% ---------- See \tabcap above for why the closing \null is load-bearing.
\newcommand{\figcaption}[1]{%
  \nointerlineskip\nopagebreak
  {\setlength{\parskip}{0pt}\setlength{\parindent}{0pt}%
   \noindent\null\hfil
   \begin{minipage}{0.94\linewidth}%
   \centering\footnotesize\itshape #1%
   \end{minipage}%
   \hfil\null\par}%
  \ifappfloating\else\vskip 12pt\relax\fi}

