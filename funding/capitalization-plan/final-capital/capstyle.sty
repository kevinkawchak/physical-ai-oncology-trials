% drift past the heading of the section that discusses it.  main.tex also
% issues \clearpage between sections that open with a float.
\AtBeginDocument{\let\apply@oldsection\section
  \renewcommand{\section}{\FloatBarrier\apply@oldsection}}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{caption}
\RequirePackage{adjustbox}
