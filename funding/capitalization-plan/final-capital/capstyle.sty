% ============================================================
% SHARED QUANTITATIVE PRIMITIVES.  Small reusable chart parts so a figure that
% carries data reads as a chart rather than a box-and-arrow drawing, while
% staying pure TikZ: no plotting package, no raster output.
% ============================================================
% \hbarrow{y}{x-end}{fill}{left label}{right label}
\newcommand{\hbarrow}[5]{%
  \node[anchor=east,font=\tiny\sffamily] at (-0.12,#1) {#4};
  \fill[#3] (0,#1-0.17) rectangle (#2,#1+0.17);
  \draw[protoblack,line width=0.3pt] (0,#1-0.17) rectangle (#2,#1+0.17);
  \node[anchor=west,font=\tiny\sffamily] at (#2+0.10,#1) {#5};}
% \vbarcol{x}{height}{fill}{x label}{top label}
\newcommand{\vbarcol}[5]{%
  \fill[#3] (#1-0.26,0) rectangle (#1+0.26,#2);
  \draw[protoblack,line width=0.3pt] (#1-0.26,0) rectangle (#1+0.26,#2);
  \node[font=\tiny\sffamily,anchor=north,text width=16mm,align=center] at (#1,-0.07) {#4};
  \node[font=\tiny\sffamily,anchor=south,inner sep=1.5pt] at (#1,#2) {#5};}
% \vbarpair{x}{h1}{h2}{fill1}{fill2}{x label} - control beside experimental
\newcommand{\vbarpair}[6]{%
  \fill[#4] (#1-0.30,0) rectangle (#1-0.02,#2);
  \draw[protoblack,line width=0.3pt] (#1-0.30,0) rectangle (#1-0.02,#2);
  \fill[#5] (#1+0.02,0) rectangle (#1+0.30,#3);
  \draw[protoblack,line width=0.3pt] (#1+0.02,0) rectangle (#1+0.30,#3);
  \node[font=\tiny\sffamily,anchor=north,text width=17mm,align=center] at (#1,-0.07) {#6};}
% \hmcell{x}{y}{tint 0-100}{label} - one heat-map cell on the blue ramp.
\newcommand{\hmcell}[4]{%
  \fill[protoblue!#3] (#1,#2) rectangle (#1+1,#2+0.55);
  \draw[protoblack!35,line width=0.2pt] (#1,#2) rectangle (#1+1,#2+0.55);
  \node[font=\tiny\sffamily,text=black] at (#1+0.5,#2+0.275) {#4};}
\newcommand{\hmcellw}[4]{%
  \fill[protoblue!#3] (#1,#2) rectangle (#1+1,#2+0.55);
  \draw[protoblack!35,line width=0.2pt] (#1,#2) rectangle (#1+1,#2+0.55);
  \node[font=\tiny\sffamily,text=white] at (#1+0.5,#2+0.275) {#4};}
% \ciband{y}{lo}{hi}{point}{label} - an exact interval on a rule.
\newcommand{\ciband}[5]{%
  \draw[protoblue,line width=1.1pt] (#2,#1) -- (#3,#1);
  \draw[protoblack,line width=0.5pt] (#2,#1-0.10) -- (#2,#1+0.10);
  \draw[protoblack,line width=0.5pt] (#3,#1-0.10) -- (#3,#1+0.10);
  \fill[protoblue] (#4,#1) circle (0.055);
  \node[anchor=east,font=\tiny\sffamily] at (-0.15,#1) {#5};}
% \axisx{x0}{x1}{y} and \axisy{y0}{y1}{x} - hairline chart rules.
\newcommand{\axisx}[3]{\draw[protogray,line width=0.4pt] (#1,#3) -- (#2,#3);}
\newcommand{\axisy}[3]{\draw[protogray,line width=0.4pt] (#3,#1) -- (#3,#2);}
% \legkey{x}{y}{fill}{text} - one legend swatch.
\newcommand{\legkey}[4]{%
  \fill[#3] (#1,#2-0.09) rectangle (#1+0.30,#2+0.09);
  \draw[protoblack,line width=0.3pt] (#1,#2-0.09) rectangle (#1+0.30,#2+0.09);
  \node[anchor=west,font=\tiny\sffamily] at (#1+0.38,#2) {#4};}
% \ptitle{x}{y}{text} - an in-figure panel title.
\newcommand{\ptitle}[3]{\node[font=\scriptsize\sffamily\bfseries,text=protoblue,anchor=west] at (#1,#2) {#3};}
% \pnote{x}{y}{text} - an in-figure footnote line.
\newcommand{\pnote}[3]{\node[font=\tiny\sffamily,text=protogray,anchor=west,align=left] at (#1,#2) {#3};}
% \pxmark{x}{y} - the struck-through-cable glyph used where an edge is absent.
\newcommand{\pxmark}[2]{%
  \draw[protoblack,line width=0.9pt] (#1-0.13,#2-0.13) -- (#1+0.13,#2+0.13);
  \draw[protoblack,line width=0.9pt] (#1-0.13,#2+0.13) -- (#1+0.13,#2-0.13);}

% ============================================================
% PAPER FURNITURE.  This paper's cover varies from two predecessors at once.
% It is not the RFA-RM-27-001-v2 centred form-field theme, and it is not the
% left-accent masthead over a ten-cell recipient strip used by
% pdac-funding-applications/final-apply.  It is a ruled panel with a top accent
% band over a three-cell money ledger, because the subject is one recipient and
% three numbers.  The environment and macro names appfig, appfloat, apptable and
% figcaption are kept unchanged, so a figure written for the parent work
% compiles here without edit.
% ============================================================
% \capmast{eyebrow}{title}{subtitle} - a ruled panel with a top accent band.
\newcommand{\capmast}[3]{%
  \par\noindent\begin{tikzpicture}
    \node[rectangle,draw=protoblue,line width=0.7pt,fill=protowhite,
          text width=\dimexpr\textwidth-22pt\relax,
          inner xsep=9pt,inner ysep=9pt,align=left,anchor=north west] (mh) at (0,-0.16)
          {{\footnotesize\sffamily\bfseries\color{protogray} #1}\\[0.40em]
           {\LARGE\bfseries\color{protoblue} #2}\\[0.40em]
           {\small #3}};
    \fill[protoblue] ([yshift=0.16cm]mh.north west) rectangle ([yshift=0.02cm]mh.north east);
  \end{tikzpicture}\par}
% \capcell{name}{label}{amount}{term}{fill}{textcolour} - one ledger cell.  The
% amount is set on its own line at \small so the three numbers align optically
% across the strip whatever their label length.
\newcommand{\capcell}[6]{%
  \node[rectangle,draw=protoblue,line width=0.6pt,rounded corners=2pt,fill=#5,
        text width=\dimexpr0.28\textwidth-9pt\relax,minimum height=13.5mm,
        inner sep=4pt,align=center,font=\tiny\sffamily,text=#6,anchor=north west]
        (#1) at (0,0)
        {\textbf{#2}\\[0.20em]{\small\bfseries #3}\\[0.16em]#4};}
% \capledger{...} - the three-cell money strip.  Cells are placed by an explicit
% xshift chain rather than by a \foreach over a fill list, because choosing a
% fill with \ifnum inside a TikZ key list expands too late.
\newcommand{\capledger}[9]{%
  \par\addvspace{0.32em}%
  \noindent\begin{tikzpicture}
    \capcell{lc@a}{#1}{#2}{#3}{protoblue}{protowhite}
    \node[rectangle,draw=protoblue,line width=0.6pt,rounded corners=2pt,fill=pablue2,
          text width=\dimexpr0.28\textwidth-9pt\relax,minimum height=13.5mm,
          inner sep=4pt,align=center,font=\tiny\sffamily,text=protoblue,
          anchor=north west]
          (lc@b) at ([xshift=0.055\textwidth]lc@a.north east)
          {\textbf{#4}\\[0.20em]{\small\bfseries #5}\\[0.16em]#6};
    \node[rectangle,draw=protogray,line width=0.6pt,rounded corners=2pt,fill=pagrayl,
          text width=\dimexpr0.28\textwidth-9pt\relax,minimum height=13.5mm,
          inner sep=4pt,align=center,font=\tiny\sffamily,text=protoblack,
          anchor=north west]
          (lc@c) at ([xshift=0.055\textwidth]lc@b.north east)
          {\textbf{#7}\\[0.20em]{\small\bfseries #8}\\[0.16em]#9};
  \end{tikzpicture}\par\addvspace{0.32em}}
% \appbadge{text} / \appbadgel{text} - inline badges shared by all variants.
\newcommand{\appbadge}[1]{%
  \tikz[baseline=(bd.base)]{\node[rectangle,rounded corners=2pt,fill=protoblue,
    text=protowhite,inner xsep=5pt,inner ysep=2pt,font=\scriptsize\bfseries] (bd) {#1};}}
\newcommand{\appbadgel}[1]{%
  \tikz[baseline=(bd.base)]{\node[rectangle,rounded corners=2pt,fill=pablue2,
    draw=protoblue,line width=0.5pt,text=protoblue,inner xsep=5pt,inner ysep=2pt,
    font=\scriptsize\bfseries] (bd) {#1};}}
% \apprule{width} - the thin accent rule used between cover blocks.
\newcommand{\apprule}[1]{{\color{protoblue}\rule{\linewidth}{#1}}}
% \draftinstr{...} - a bracketed drafting instruction, draft stage only.  Every
% one names the exact repository file or directory a later stage must process.
% No \draftinstr survives into full-apply or final-apply.
\newcommand{\draftinstr}[1]{\par\addvspace{3pt}%
  {\setlength{\parindent}{0pt}\small\color{protogray}%
   \textbf{[DRAFTING INSTRUCTION]}\itshape\ #1\par}%
  \addvspace{3pt}}
% \figslot{tag}{height in cm}{caption} - a sized placeholder carrying its final
% figure number and type tag, so figure numbering never moves after this stage.
\newcommand{\figslot}[3]{%
  \begin{appfloat}[!tb]
  \begin{appfig}[#1]
  \draw[pagraym,line width=0.5pt] (0,0) rectangle (13.6,#2);
  \node[font=\scriptsize\sffamily,text=protogray] at (6.8,{#2/2}) {placeholder, drawn in full-apply};
  \end{appfig}
  \vspace{-0.65cm}
  \figcaption{#3}
  \end{appfloat}}

% \pfb - a zero-width break opportunity, for use inside \texttt paths and TikZ
% labels, so a long repository path can never overflow the measure.
\newcommand{\pfb}{\discretionary{}{}{}}
% \appfile{path} is defined at the foot of this file, after url and hyperref.

% ---------- PNG-free ORCID iD mark. ----------
\newcommand{\orcidicon}[1]{%
  \href{https://orcid.org/#1}{\protect\tikz[baseline=-0.75ex]{%
    \node[circle,fill=orcidgreen,minimum size=9.2pt,inner sep=0pt](orc){};
    \node at (orc){\textcolor{white}{\sffamily\bfseries\fontsize{5.4}{5.4}\selectfont iD}};}}}

% ---------- Table of contents.  article.cls opens every section entry with
% ---------- \addvspace{1.0em}, which over twelve sections spills the contents
% ---------- onto a second page that is then mostly empty.  The lead is reduced
% ---------- to 0.20em, which keeps the sections visually grouped and brings the
% ---------- contents back to a single page.
\makeatletter
\renewcommand*\l@section[2]{%
  \ifnum \c@tocdepth >\z@
    \addpenalty\@secpenalty
    \addvspace{0.20em \@plus\p@}%
    \setlength\@tempdima{1.5em}%
    \begingroup
      \parindent \z@ \rightskip \@pnumwidth
      \parfillskip -\@pnumwidth
      \leavevmode \bfseries
      \advance\leftskip\@tempdima
      \hskip -\leftskip
      #1\nobreak\hfil
      \nobreak\hb@xt@\@pnumwidth{\hss #2\kern-\p@\kern\p@}\par
    \endgroup
  \fi}
\makeatother

\providecommand{\keywordname}{\textbf{Keywords}}
\providecommand{\keywords}[1]{\par\addvspace{\smallskipamount}%
  {\setlength{\parindent}{0pt}\footnotesize\keywordname\enspace #1\par}}
\providecommand{\bmhead}[1]{\par\addvspace{0.45\baselineskip}\needspace{2\baselineskip}%
  \phantomsection\addcontentsline{toc}{section}{#1}%
  {\noindent\large\bfseries\color{accentcol}#1}\par\addvspace{2pt}}
\providecommand{\cboxx}{\raisebox{0.12ex}{\framebox[1.25ex]{\rule{0pt}{0.95ex}}}}

\RequirePackage[hidelinks,pdfusetitle]{hyperref}
\RequirePackage{url}
% The url package resets \UrlBreaks when it loads, so the any-character break
% rule is re-asserted here, after url and hyperref, together with stretchable
% inter-character glue.  Without this a long bibliography URL cannot be broken
% and overflows the measure.
\def\UrlBreaks{\do\/\do-\do.\do=\do_\do?\do\&\do\%\do\#\do\:\do\a\do\b\do\c%
\do\d\do\e\do\f\do\g\do\h\do\i\do\j\do\k\do\l\do\m\do\n\do\o\do\p\do\q\do\r%
\do\s\do\t\do\u\do\v\do\w\do\x\do\y\do\z\do\A\do\B\do\C\do\D\do\E\do\F\do\G%
\do\H\do\I\do\J\do\K\do\L\do\M\do\N\do\O\do\P\do\Q\do\R\do\S\do\T\do\U\do\V%
\do\W\do\X\do\Y\do\Z\do\0\do\1\do\2\do\3\do\4\do\5\do\6\do\7\do\8\do\9}
\Urlmuskip=0mu plus 3mu\relax
% \appfile{path} - a repository path in monospace.  \nolinkurl and \path both
% failed to break these paths inside a \draftinstr argument, so the scanner
% below inserts an explicit break opportunity after every character: a path can
% then wrap anywhere and can never overflow the measure.  \penalty300 keeps TeX
% preferring a real word space when one is available.
\makeatletter
\def\app@fend{\app@fend}
\def\app@fscan#1{%
  \ifx\app@fend#1%
    \let\app@fnext\relax
  \else
    #1\penalty300\relax
    \let\app@fnext\app@fscan
  \fi
  \app@fnext}
\newcommand{\appfile}[1]{{\ttfamily\hyphenchar\font=-1\relax
  \app@fscan#1\app@fend}}
\makeatother
% ============================================================
% CLICKABLE DOIs AND URLs IN THE REFERENCE LIST.
%
% THE DEFECT.  references.bib carries a doi field on twenty entries and a url
% field on thirty-seven, and the file's own header says capstyle.sty renders the
% DOI as text with a clickable target.  It did not, because unsrt.bst reads
% neither field: BibTeX simply drops both, and no amount of hyperref
% configuration can hyperlink data that never reached the .bbl.  The compiled
% reference list carried no DOI, no URL and no target at all - plain text, as
% the author reported.
%
% THE FIX, IN TWO PARTS.  sections/sec-11 asks for unsrturl rather than unsrt.
% unsrturl is the urlbst-generated companion of unsrt shipped with TeX Live and
% with Overleaf; it is unsrt entry for entry, plus two closing blocks: an entry
% with a doi prints \href{https://doi.org/D}{doi:D}, and an entry without one
% prints its url through \url.  An entry carrying both, which is this bib file's
% convention where the url is the DOI resolver, prints the DOI only, so no
% reference shows the same target twice.  This file supplies the second part:
% the marking that makes those targets look like targets.
%
% WHY THE COLOUR IS SCOPED THE WAY IT IS.  hyperref is loaded with hidelinks, so
% the contents, the internal cross-references and the cover's prose links carry
% no decoration, which is what a printed page wants.  A reference list is the
% one place a reader is expected to click, so a printed DOI or URL - anything
% set through \url, \path or \dlink - is marked in the accent colour, and
% nothing else is.  The rule is: a link whose text IS its target is coloured; a
% link hidden behind prose is not.  No ninth palette token is introduced.
% ============================================================
\renewcommand{\UrlFont}{\ttfamily\color{accentcol}}
% \dlink{10.5281/zenodo.NNNNNNN} - a DOI printed as text and hyperlinked, so
% every reference carries both the DOI string and a clickable target.
\newcommand{\dlink}[1]{\href{https://doi.org/#1}{\textcolor{accentcol}{#1}}}
% urlbst's .bbl declares these with \providecommand, so declaring them here wins
% and keeps the reference list's wording under this file's control.
\providecommand{\urlprefix}{URL: }
\providecommand{\doitext}{doi:}
% Ragged-right bibliography with generous emergency stretch, so no reference
% line runs past the right margin.
\AtBeginDocument{%
  \let\appoldbibliography\thebibliography
  \renewcommand{\thebibliography}[1]{%
    \appoldbibliography{#1}\raggedright\emergencystretch=8em\relax
    \setlength{\itemsep}{0.8pt}\setlength{\parsep}{0pt}\setlength{\topsep}{0pt}}}
% \apprefs{...} - the reference list set in two columns at \scriptsize.  A
% five-page application cannot afford a single-column list of long protocol
% titles, and two columns halve its height without shrinking the type further.
% The label width is fixed so the two columns align, and the section heading is
% set above the columns rather than inside them.
\newenvironment{apprefs}%
  {\needspace{4\baselineskip}%
   \setlength{\multicolsep}{0pt}\setlength{\columnsep}{13pt}%
   \begin{multicols}{2}\scriptsize\raggedright
   \setlength{\emergencystretch}{10em}%
   \renewcommand{\section}[2]{}}%
  {\end{multicols}}
\captionsetup{font=small,labelfont=bf,justification=raggedright,singlelinecheck=false}

% ============================================================
% DIAGRAM X SHIFT.  A figure whose content is optically heavier on one side
% reads as though it were off the measure even when its frame is centred.  The
% author's correction 11 nudges such a figure by a named length rather than by
% an ad hoc \hspace, so the shift is auditable and identical wherever it is
% used.  The caption spacing is untouched: \figcaption still follows
% \vspace{-0.65cm} and still sits at 6.06pt from the frame rule.
%
%   \begin{appfloat}[!tb]
%   \begin{adjustwidth}{\DiagramXShift}{\dimexpr-\DiagramXShift\relax}
%   \begin{appfig}[type / construct]  ...  \end{appfig}
%   \end{adjustwidth}
%   \vspace{-0.65cm}
%   \figcaption{...}
%   \end{appfloat}
%
% THE LENGTH IS NOW ZERO, AND THE CARRIER STAYS.  Stage 8 measured every frame
% and every caption in the compiled PDF against the 306pt page centre and found
% all of them 13.1pt to the right of it.  The cause was not the diagrams: it was
% the trailing \hfil in this file's own centring idiom, which TeX deletes when a
% paragraph ends in glue, leaving the leading \hfil to absorb the whole slack.
% The three carriers now close with \null, the twenty frames measure 306.00pt
% and the forty-one captions 305.75pt, and a 1.5mm nudge on top of that would
% put the one figure that carries it off centre by itself.  Measured at 0mm the
% wrapper still cost Figure 13 1.86pt, because adjustwidth is a list environment
% and a list brings its own margin handling, so that figure is now unwrapped and
% no figure in this paper uses the carrier.  It is kept, documented and set to
% zero, so a future optical correction has one named length to change and one
% named environment to wrap, and nothing else.
% ============================================================
\newlength{\DiagramXShift}
\setlength{\DiagramXShift}{0mm}
\endinput
