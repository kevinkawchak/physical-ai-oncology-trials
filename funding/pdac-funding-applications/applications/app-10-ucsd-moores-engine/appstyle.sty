  \foreach \k in {-0.09,0,0.09}{\draw (\k,0.16) -- (\k,0.25);\draw (\k,-0.16) -- (\k,-0.25);
  \draw (0.16,\k) -- (0.25,\k);\draw (-0.16,\k) -- (-0.25,\k);}\end{scope}}
\newcommand{\glyphnet}[2]{\begin{scope}[shift={(#1.center)},draw=#2,line width=0.45pt]
  \draw (-0.24,0.22) rectangle (-0.06,0.06);\draw (0.06,0.22) rectangle (0.24,0.06);
  \draw (-0.09,-0.28) rectangle (0.09,-0.12);
