% \umlactor{name}{x}{y}{label} - a UML stick actor with the label beneath.
\newcommand{\umlactor}[4]{%
  \begin{scope}[shift={(#2,#3)},draw=protoblue,line width=0.6pt]
    \draw (0,0.30) circle (0.13);
    \draw (0,0.17) -- (0,-0.20);
    \draw (-0.20,0.02) -- (0.20,0.02);
    \draw (0,-0.20) -- (-0.17,-0.48);
    \draw (0,-0.20) -- (0.17,-0.48);
  \end{scope}
  \node[font=\tiny\sffamily,text width=23mm,align=center,anchor=north] (#1) at (#2,{#3-0.56}) {#4};}

% Fault-tree gate glyphs, used by the graphviz-type fault tree.  An AND gate
% has a flat bottom; an OR gate has a curved bottom.  Neither is filled black.
\newcommand{\umlgateand}[2]{%
  \draw[draw=protoblack,line width=0.6pt,fill=pagraym]
    (#1-0.32,#2-0.20) -- (#1-0.32,#2+0.02)
    arc (180:0:0.32 and 0.26) -- (#1+0.32,#2-0.20) -- cycle;
  \node[font=\tiny\sffamily,anchor=north] at (#1,#2-0.22) {AND};}
\newcommand{\umlgateor}[2]{%
  \draw[draw=protoblack,line width=0.6pt,fill=pagrayl]
    (#1-0.32,#2-0.20) .. controls (#1-0.10,#2-0.06) and (#1+0.10,#2-0.06) .. (#1+0.32,#2-0.20)
    -- (#1+0.32,#2+0.02) arc (0:180:0.32 and 0.26) -- cycle;
  \node[font=\tiny\sffamily,anchor=north] at (#1,#2-0.22) {OR};}

