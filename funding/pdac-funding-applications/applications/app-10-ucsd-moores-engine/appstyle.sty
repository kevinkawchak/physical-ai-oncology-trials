\RequirePackage[hidelinks,pdfusetitle]{hyperref}
\RequirePackage{url}
% The url package resets \UrlBreaks when it loads, so the any-character break
% rule is re-asserted here, after url and hyperref, together with stretchable
% inter-character glue.  Without this a long bibliography URL cannot be broken
% and overflows the measure.
\def\UrlBreaks{\do\/\do-\do.\do=\do_\do?\do\&\do\%\do\#\do\:\do\a\do\b\do\c%
\do\d\do\e\do\f\do\g\do\h\do\i\do\j\do\k\do\l\do\m\do\n\do\o\do\p\do\q\do\r%
\do\s\do\t\do\u\do\v\do\w\do\x\do\y\do\z\do\A\do\B\do\C\do\D\do\E\do\F\do\G%
\do\H\do\I\do\J\do\K\do\L\do\M\do\N\do\O\do\P\do\Q\do\R\do\S\do\T\do\U\do\V%
\do\W\do\X\do\Y\do\Z\do\0\do\1\do\2\do\3\do\4\do\5\do\6\do\7\do\8\do\9}
\Urlmuskip=0mu plus 3mu\relax
% \dlink{10.5281/zenodo.NNNNNNN} - a DOI printed as text and hyperlinked, so
% every reference carries both the DOI string and a clickable target.
\newcommand{\dlink}[1]{\href{https://doi.org/#1}{#1}}
% Ragged-right bibliography with generous emergency stretch, so no reference
% line runs past the right margin.
\AtBeginDocument{%
  \let\appoldbibliography\thebibliography
  \renewcommand{\thebibliography}[1]{%
    \appoldbibliography{#1}\raggedright\emergencystretch=8em\relax
    \setlength{\itemsep}{1.2pt}\setlength{\parsep}{0pt}}}
% \apprefs{...} - the reference list set in two columns at \scriptsize.  A
% five-page application cannot afford a single-column list of long protocol
% titles, and two columns halve its height without shrinking the type further.
% The label width is fixed so the two columns align, and the section heading is
% set above the columns rather than inside them.
\newenvironment{apprefs}%
  {\needspace{4\baselineskip}%
   \begin{multicols}{2}\scriptsize\raggedright
   \setlength{\emergencystretch}{10em}%
   \renewcommand{\section}[2]{}}%
  {\end{multicols}}
\captionsetup{font=small,labelfont=bf,justification=raggedright,singlelinecheck=false}
