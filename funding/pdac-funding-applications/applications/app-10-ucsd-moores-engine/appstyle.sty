% \dgnode{style}{x}{y}{glyph}{label}{name} - icon tile with the label beneath.
% Defines two nodes: <name> (the tile) and <name>l (the label), so a surrounding
% \node[dgcluster,fit=(n1)(n1l)...] encloses both.
\newcommand{\dgnode}[6]{%
  \node[#1] (#6) at (#2,#3) {};
  #4{#6}{protoblue}%
  \node[dglabel,anchor=north] (#6l) at ([yshift=-5.4mm]#6.center) {#5};}
\newcommand{\dgnodew}[6]{% dark-blue tile, white pictogram
  \node[#1] (#6) at (#2,#3) {};
  #4{#6}{protowhite}%
  \node[dglabel,anchor=north] (#6l) at ([yshift=-5.4mm]#6.center) {#5};}
\newcommand{\dgnodeg}[6]{% gray tile, gray pictogram
  \node[#1] (#6) at (#2,#3) {};
  #4{#6}{protogray}%
  \node[dglabel,anchor=north] (#6l) at ([yshift=-5.4mm]#6.center) {#5};}

