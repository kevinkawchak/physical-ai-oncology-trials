\def\GrantPDFBorderColor{0.17 0.41 0.58}
\def\GrantPDFBackgroundColor{1 1 1}
% -----------------------------------------------------------------------------
% Direct-edit field interface
%
% Every editable field keeps its settings next to its text. Examples:
%
% \GrantLineField[id=project-title,font=10pt,maxchars=220]{Project title}{My title}
%
% \GrantTextArea[id=abstract,font=9pt,height=3in,maxchars=3200]{Abstract}{%
%   Type or paste the abstract here.
% }
%
% font=auto lets the PDF viewer auto-fit. Replace it with font=10pt, 9pt,
% 8.5pt, etc. for a fixed field font size.
% -----------------------------------------------------------------------------
\ExplSyntaxOn
\tl_new:N  \l__grant_id_tl
\tl_new:N  \l__grant_font_tl
\tl_new:N  \l__grant_charsize_tl
\dim_new:N \l__grant_width_dim
\dim_new:N \l__grant_height_dim
\int_new:N \l__grant_maxchars_int
\int_new:N \g__grant_auto_id_int
\keys_define:nn { grant / field }
  {
    id       .tl_set:N  = \l__grant_id_tl,
    font     .tl_set:N  = \l__grant_font_tl,
    width    .dim_set:N = \l__grant_width_dim,
    height   .dim_set:N = \l__grant_height_dim,
    maxchars .int_set:N = \l__grant_maxchars_int,
  }
\cs_new_protected:Npn \grant_field_setup:nnnnn #1#2#3#4#5
  {
    \tl_clear:N \l__grant_id_tl
    \tl_set:Nn \l__grant_font_tl { auto }
    \dim_set:Nn \l__grant_width_dim { #2 }
    \dim_set:Nn \l__grant_height_dim { #3 }
    \int_set:Nn \l__grant_maxchars_int { #4 }
    \keys_set:nn { grant / field } { #1 }
    \tl_trim_spaces:N \l__grant_id_tl
    \tl_set:Nx \l__grant_font_tl { \tl_use:N \l__grant_font_tl }
    \tl_trim_spaces:N \l__grant_font_tl
    \tl_if_blank:VTF \l__grant_id_tl
      {
        \int_gincr:N \g__grant_auto_id_int
        \tl_set:Nx \l__grant_id_tl { grant-field-\int_use:N \g__grant_auto_id_int }
      }
      { }
    \str_if_eq:VnTF \l__grant_font_tl { auto }
      { \tl_set:Nn \l__grant_charsize_tl { 0pt } }
      { \tl_set_eq:NN \l__grant_charsize_tl \l__grant_font_tl }
    \edef\GrantResolvedID{\tl_use:N \l__grant_id_tl}
    \edef\GrantResolvedFont{\tl_use:N \l__grant_charsize_tl}
    \edef\GrantResolvedWidth{\dim_use:N \l__grant_width_dim}
    \edef\GrantResolvedHeight{\dim_use:N \l__grant_height_dim}
    \edef\GrantResolvedMaxChars{\int_use:N \l__grant_maxchars_int}
    #5
  }
\NewDocumentCommand{\GrantLineField}{ O{} m +m }
  {
    \par\smallskip
    \noindent\begin{minipage}{\linewidth}
    \grant_field_setup:nnnnn {#1} {\linewidth} {0.34in} {220}
      {
        \GrantFieldHeading{#2}{\GrantResolvedMaxChars}
        \noindent\TextField[
          name={\GrantResolvedID},
          value={#3},
          width=\GrantResolvedWidth,
          height=\GrantResolvedHeight,
          charsize=\GrantResolvedFont,
          maxlen=\GrantResolvedMaxChars,
          bordercolor={\GrantPDFBorderColor},
          backgroundcolor={\GrantPDFBackgroundColor},
          borderwidth=1
        ]{}\par
      }
    \end{minipage}\par
  }
\NewDocumentCommand{\GrantInlineField}{ O{} m +m }
  {
    \textbf{#2}\quad
    \grant_field_setup:nnnnn {#1} {2.2in} {0.28in} {120}
      {
        \TextField[
          name={\GrantResolvedID},
          value={#3},
          width=\GrantResolvedWidth,
          height=\GrantResolvedHeight,
          charsize=\GrantResolvedFont,
          maxlen=\GrantResolvedMaxChars,
          bordercolor={\GrantPDFBorderColor},
          backgroundcolor={\GrantPDFBackgroundColor},
          borderwidth=1
        ]{}
      }
  }
\NewDocumentCommand{\GrantTextArea}{ O{} m +m }
  {
    \par\smallskip
    \noindent\begin{minipage}{\linewidth}
    \grant_field_setup:nnnnn {#1} {\linewidth} {1.5in} {1500}
      {
        \GrantFieldHeading{#2}{\GrantResolvedMaxChars}
        \noindent\TextField[
          name={\GrantResolvedID},
          value={#3},
          multiline=true,
          width=\GrantResolvedWidth,
          height=\GrantResolvedHeight,
          charsize=\GrantResolvedFont,
          maxlen=\GrantResolvedMaxChars,
          bordercolor={\GrantPDFBorderColor},
          backgroundcolor={\GrantPDFBackgroundColor},
          borderwidth=1
        ]{}\par
      }
    \end{minipage}\par
  }
\NewDocumentCommand{\GrantPageArea}{ O{} m +m }
  {
    \GrantTextArea[height=0.70\textheight,maxchars=6500,#1]{#2}{#3}
  }
\NewDocumentCommand{\GrantTableField}{ O{} +m }
  {
    \grant_field_setup:nnnnn {#1} {0.98\linewidth} {0.29in} {120}
      {
        \TextField[
          name={\GrantResolvedID},
          value={#2},
          width=\GrantResolvedWidth,
          height=\GrantResolvedHeight,
          charsize=\GrantResolvedFont,
          maxlen=\GrantResolvedMaxChars,
          bordercolor={\GrantPDFBorderColor},
          backgroundcolor={\GrantPDFBackgroundColor},
          borderwidth=1
        ]{}
      }
  }
\keys_define:nn { grant / signature }
  {
    signature-font .tl_set:N = \l_tmpa_tl,
    date-font      .tl_set:N = \l_tmpb_tl,
  }
\NewDocumentCommand{\GrantSignatureLine}{ O{} m m }
  {
    \tl_set:Nn \l_tmpa_tl { auto }
    \tl_set:Nn \l_tmpb_tl { auto }
    \keys_set:nn { grant / signature } {#1}
    \begin{tabularx}{\linewidth}{X p{1.65in}}
      \GrantTableField[id=#2,font=\l_tmpa_tl,width=\linewidth,maxchars=120]{Kevin~Kawchak}
      &
      \GrantTableField[id=#3,font=\l_tmpb_tl,width=\linewidth,maxchars=30]{July~7,~2026}
      \\
      {\scriptsize Signature~/~typed~certification} & {\scriptsize Date}
    \end{tabularx}
  }
\ExplSyntaxOff
