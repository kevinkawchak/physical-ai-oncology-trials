% -----------------------------------------------------------------------------
% Citations inside AcroForm field values
%
% A PDF text-field value is a PDF string, not ordinary typeset LaTeX. Natbib's
% \citep therefore cannot be expanded directly by hyperref. The build script
% generates field-safe citation strings from natbib's final \bibcite labels.
% A post-build pass overlays invisible internal links on those rendered labels;
% the widgets, dimensions, values, fonts, borders, and backgrounds are unchanged.
% -----------------------------------------------------------------------------
\providecommand{\GrantFieldCiteString}[1]{%
  \ifcsname GrantFieldCite@#1\endcsname
    \csname GrantFieldCite@#1\endcsname
  \else
    \detokenize{[citation pending]}%
  \fi
}
\InputIfFileExists{grant-field-cite-labels.tex}{}{}
\pdfstringdefDisableCommands{%
  \def\citep#1{\GrantFieldCiteString{#1}}%
}
\AtBeginDocument{%
  \InputIfFileExists{grant-field-citations.tex}{}{}%
}
