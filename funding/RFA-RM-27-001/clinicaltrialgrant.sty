% -----------------------------------------------------------------------------
% Citation and reference formatting
%
% - Parenthetical citations are printed as [Author, Year] rather than
%   (Author, Year).
% - unsrtnat lists references in first-citation order.
% - For otherwise identical author-year labels, unsrtnat assigns a, b, c, ...
%   in that same first-citation order.
% - Each bibliography entry is prepended with the same bracketed label used in
%   the body, for example: [NIH, 2026a].
% -----------------------------------------------------------------------------
\bibpunct[, ]{[}{]}{;}{a}{,}{,}

% Suppress redundant URL fields that duplicate DOIs to prevent "double URLs"
\def\urlprefix\url#1{%
  \IfSubStr{#1}{doi.org}{}{URL \url{#1}}%
}

\makeatletter
% Keep the required citation-order bibliography style even when a document
% contains \bibliographystyle{...}. If the document omits that command, the
% style is written automatically when \bibliography{...} is used.
\newif\ifgrant@bibstylewritten
\grant@bibstylewrittenfalse
\let\grant@original@bibliographystyle\bibliographystyle
\newcommand{\grant@write@bibliographystyle}{%
  \ifgrant@bibstylewritten
  \else
    \grant@original@bibliographystyle{unsrtnat}%
    \global\grant@bibstylewrittentrue
  \fi
}
\renewcommand{\bibliographystyle}[1]{%
  \grant@write@bibliographystyle
  \ifdefstring{#1}{unsrtnat}{}{%
    \PackageWarning{clinicaltrialgrant}{%
      Bibliography style `#1' ignored; using `unsrtnat' so references and
      author-year suffixes follow first-citation order%
    }%
  }%
}
\pretocmd{\bibliography}{\grant@write@bibliographystyle}{}{%
  \PackageError{clinicaltrialgrant}{Unable to configure bibliography style}{%
    Add \string\bibliographystyle{unsrtnat} before
    \string\bibliography in the main document.%
  }%
}
% This macro is inserted immediately after natbib starts each bibliography
% item. On normal LaTeX/BibTeX runs, \NAT@name and \NAT@date contain the same
% short author and suffixed year used by \citep.
\newcommand{\grant@print@biblabel}{%
  \ifx\NAT@name\@empty
  \else
    {[\NAT@nmfmt{\NAT@name}, \NAT@date]}\nobreakspace
  \fi
}
\AtBeginDocument{%
  \apptocmd{\@lbibitem}{\grant@print@biblabel}{}{%
    \PackageError{clinicaltrialgrant}{Unable to prepend bibliography labels}{%
      The installed natbib definition of \string\@lbibitem could not be
      patched. Check the natbib package version.%
    }%
  }%
}
